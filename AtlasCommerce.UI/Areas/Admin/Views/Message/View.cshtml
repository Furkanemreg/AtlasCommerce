@using AtlasCommerce.Application.ViewModels
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mesaj Görüntüle";
}

@model MessageVM

<div class="max-w-4xl mx-auto rounded-md my-5">
    <div class="space-y-12">
        <div class="border-b border-gray-900/10 pb-12">
            <h2 class="text-base/7 font-semibold theme-label">Mesaj</h2>
            <p class="mt-1 text-sm/6 text-gray-600"></p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-4">
                    <label asp-for="Topic" class="block text-sm/6 font-medium theme-label">Konu</label>
                    <div class="mt-2">
                        <textarea asp-for="Topic" rows="3" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled></textarea>
                    </div>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="Message" class="block text-sm/6 font-medium theme-label">Mesaj</label>
                    <div class="mt-2">
                        <textarea asp-for="Message" rows="4" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled></textarea>
                    </div>
                </div>
            </div>
        </div>


        <div class="border-b border-gray-900/10 pb-12">
            <h2 class="text-base/7 font-semibold theme-label">Gönderici Bilgileri</h2>
            <p class="mt-1 text-sm/6 text-gray-600"></p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    <label asp-for="FirstName" class="block text-sm/6 font-medium theme-label">Adı</label>
                    <div class="mt-2">
                        <input asp-for="FirstName" type="text" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled />
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="LastName" class="block text-sm/6 font-medium theme-label">Soyadı</label>
                    <div class="mt-2">
                        <input asp-for="LastName" type="text" disabled class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled />
                    </div>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="PhoneNumber" class="block text-sm/6 font-medium theme-label">Telefon Numarası</label>
                    <div class="mt-2">
                        <input asp-for="PhoneNumber" type="text" disabled class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled />
                    </div>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="EmailAddress" class="block text-sm/6 font-medium theme-label">E-Posta Adresi</label>
                    <div class="mt-2">
                        <input asp-for="EmailAddress" type="text" disabled class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled />
                    </div>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="CreatedAt" class="block text-sm/6 font-medium theme-label">Oluşturulma Tarihi</label>
                    <div class="mt-2">
                        <input type="text" name="CreatedAt" value="@(Model.CreatedAt.ToString("dd.MM.yyyy HH.mm.ss") ?? String.Empty)" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" disabled/>
                    </div>
                </div>

            </div>
        </div>
        
        <div class="border-b border-gray-900/10 pb-12">
            <h2 class="text-base/7 font-semibold theme-label">Yönetici Yanıtı</h2>

            @if (string.IsNullOrWhiteSpace(Model.AdminReply))
            {
                <div class="mt-4">
                    <label class="block text-sm font-medium theme-label mb-2">Yanıtınız</label>

                    <textarea id="adminReply"
                              rows="5"
                              class="theme-input block w-full rounded-md px-3 py-1.5"></textarea>

                    <button type="button"
                            class="mt-3 px-4 py-2 bg-green-600 text-white rounded-md btn-send-reply"
                            data-id="@Model.Id">
                        Yanıtla
                    </button>
                </div>
            }
            else
            {
                <div class="mt-4 p-4 rounded-md bg-green-50 border border-green-200 text-left w-full">
                    <p class="text-sm text-gray-700">
                        @Model.AdminReply
                    </p>

                    <div class="mt-3 text-xs text-gray-500">
                        Yanıt Tarihi:
                        @Model.RepliedAt?.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            }
        </div>
        
        <div class="mt-6 flex items-left justify-left gap-x-6">
            <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="text-sm/6 font-semibold theme-label">Geri</a>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        document.addEventListener("click", async (e) => {

            const btn = e.target.closest(".btn-send-reply");
            if (!btn) return;

            const id = btn.dataset.id;
            const reply = document.getElementById("adminReply")?.value;

            if (!reply || reply.trim() === "") {
                toastr.warning("Yanıt boş olamaz.");
                return;
            }

            showConfirmationModal("Yanıtınızı göndermek istediğinizden emin misiniz?", async function () {

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const formData = new FormData();
                    formData.append("id", id);
                    formData.append("reply", reply);
                    formData.append("__RequestVerificationToken", token);

                    const response = await fetch("/Message/Reply", {
                        method: "POST",
                        body: formData
                    });

                    const res = await response.json();

                    if (res.success) {
                        toastr.success(res.message);
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        toastr.error(res.message || "Bir hata oluştu.");
                    }

                } catch (err) {
                    toastr.error("Hata oluştu.");
                    console.error(err);
                }
            });
        });

    });
</script>