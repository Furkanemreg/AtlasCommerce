@using AtlasCommerce.Application.ViewModels
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add/Edit Product";
}

@using Microsoft.AspNetCore.Mvc.Rendering
@model ProductVM

<div class="max-w-4xl mx-auto rounded-md my-5">
    <form asp-area="Admin" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="space-y-12">
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Product Description</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label asp-for="Barcode" class="block text-sm/6 font-medium theme-label">Barcode</label>
                        <div class="mt-2">
                            <input asp-for="Barcode" type="text" placeholder="Barcode" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="Barcode" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-4">
                            <small class="info-text">
                                <i class='bx bx-info-circle'></i>
                                The barcode represents the unique ID value of the product that users will see on the page. <br />
                            </small>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="Name" class="block text-sm/6 font-medium theme-label">Product Title</label>
                        <div class="mt-2">
                            <input asp-for="Name" type="text" placeholder="Product Title" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="Name" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="Description" class="block text-sm/6 font-medium theme-label">Description</label>
                        <div class="mt-2">
                            <textarea asp-for="Description" rows="4" type="text" placeholder="Description" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6"></textarea>
                            <span asp-validation-for="Description" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="ShortDescription" class="block text-sm/6 font-medium theme-label">Short Description</label>
                        <div class="mt-2">
                            <input asp-for="ShortDescription" type="text" placeholder="Short Description" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="ShortDescription" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-6">
                            <small class="info-text">
                                <i class='bx bx-info-circle'></i>
                                Short description is displayed on the product cards. <br />
                            </small>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="CategoryId" class="block text-sm/6 font-medium theme-label">Category</label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-red-600"></span>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-6">
                            <label asp-for="IsActive" class="block text-sm/6 font-medium theme-label">
                                Status
                            </label>
                            <input type="hidden" name="IsActive" id="IsActiveHidden" value="@Model.IsActive.ToString().ToLower()" />
                            <a href="javascript:void(0);"
                               id="statusToggleBtn"
                               class="status-input space-x-5 @(Model.IsActive ? "status-active" : "status-inactive")"
                               onclick="toggleStatus()">
                                @(Model.IsActive ? "Active" : "Passive")
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Sales</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label asp-for="TaxRate" class="block text-sm/6 font-medium theme-label">Tax Rate (VAT/KDV)</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="TaxRate" type="text" id="taxRate" placeholder="Tax Rate (VAT/KDV)" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">%</span>
                            </div>
                            <span asp-validation-for="TaxRate" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="OTV" class="block text-sm/6 font-medium theme-label">ÖTV</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="OTV" type="text" id="otv" placeholder="ÖTV" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">%</span>
                            </div>
                            <span asp-validation-for="OTV" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="PurchasePriceExcludingTaxes" class="block text-sm/6 font-medium theme-label">Purchase Price Excluding Taxes</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="PurchasePriceExcludingTaxes" type="text" id="purchaseExcl" placeholder="Purchase Price Excluding Taxes" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">₺</span>
                            </div>
                            <span asp-validation-for="PurchasePriceExcludingTaxes" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="SalePriceExcludingTaxes" class="block text-sm/6 font-medium theme-label">Sale Price Excluding Taxes</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="SalePriceExcludingTaxes" type="text" id="saleExcl" placeholder="Sale Price Excluding Taxes" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">₺</span>
                            </div>
                            <span asp-validation-for="SalePriceExcludingTaxes" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="PurchasePriceIncludingTaxes" class="block text-sm/6 font-medium theme-label">Purchase Price Including Taxes</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="PurchasePriceIncludingTaxes" type="text" id="purchaseIncl" placeholder="Purchase Price Including Taxes" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">₺</span>
                            </div>
                            <span asp-validation-for="PurchasePriceIncludingTaxes" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="SalePriceIncludingTaxes" class="block text-sm/6 font-medium theme-label">Sale Price Including Taxes</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="SalePriceIncludingTaxes" type="text" id="saleIncl" placeholder="Sale Price Including Taxes" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">₺</span>
                            </div>
                            <span asp-validation-for="SalePriceIncludingTaxes" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-6">
                        <label asp-for="SalePrice" class="block text-sm/6 font-medium theme-label">Sale Price</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="SalePrice" type="text" id="salePrice" disabled placeholder="Sale Price" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">₺</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-red-600 p-2"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Discount</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <div class="flex items-center space-x-6">
                            <label asp-for="IsDiscountActive" class="block text-sm/6 font-medium theme-label">
                                Apply Discount ?
                            </label>
                            <input type="hidden" name="IsDiscountActive" id="IsDiscountActiveHidden" value="@Model.IsDiscountActive.ToString().ToLower()" />
                            <a href="javascript:void(0);"
                               id="IsDiscountActiveBtn"
                               class="status-input space-x-5 @(Model.IsDiscountActive ? "status-active" : "status-inactive")"
                               onclick="toggleIsDiscountActive()">
                                @(Model.IsDiscountActive ? "Yes" : "No")
                            </a>
                        </div>
                    </div>

                    <div class="sm:col-span-3" id="discountField1" style="display: @(Model.IsDiscountActive ? "block" : "none");">
                        <label asp-for="DiscountRate" class="block text-sm/6 font-medium theme-label">Discount Rate</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="DiscountRate" type="text" id="DiscountRate" placeholder="Discount Rate" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">%</span>
                            </div>
                            <span asp-validation-for="DiscountRate" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3" id="discountField2" style="display: @(Model.IsDiscountActive ? "block" : "none");">
                        <label asp-for="DiscountStartAt" class="block text-sm/6 font-medium theme-label">Discount Start Date</label>
                        <div class="mt-2">
                            <input asp-for="DiscountStartAt" type="date" id="DiscountStartAt" placeholder="Discount Start Date" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="DiscountStartAt" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3" id="discountField3" style="display: @(Model.IsDiscountActive ? "block" : "none");">
                        <label asp-for="DiscountEndAt" class="block text-sm/6 font-medium theme-label">Discount End Date</label>
                        <div class="mt-2">
                            <input asp-for="DiscountEndAt" type="date" id="DiscountEndAt" placeholder="Discount End Date" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="DiscountEndAt" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Stock Tracking</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>
                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <div class="flex items-center space-x-6">
                            <label asp-for="StockTracking" class="block text-sm/6 font-medium theme-label">
                                Track Stock ?
                            </label>
                            <input type="hidden" name="StockTracking" id="StockTrackingHidden" value="@Model.StockTracking.ToString().ToLower()" />
                            <a href="javascript:void(0);"
                               id="StockTrackingBtn"
                               class="status-input space-x-5 @(Model.StockTracking ? "status-active" : "status-inactive")"
                               onclick="toggleStockTracking()">
                                @(Model.StockTracking ? "Yes" : "No")
                            </a>
                        </div>
                    </div>

                    <div class="sm:col-span-3" id="criticalStockField" style="display: @(Model.StockTracking ? "block" : "none");">
                        <label asp-for="CriticalStockLevel" class="block text-sm/6 font-medium theme-label">Critical Stock Level</label>
                        <div class="mt-2">
                            <input asp-for="CriticalStockLevel" type="text" placeholder="Critical Stock Level (Quantity)" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="CriticalStockLevel" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="StockQuantity" class="block text-sm/6 font-medium theme-label">Stock Quantity</label>
                        <div class="mt-2">
                            <input asp-for="StockQuantity" type="text" placeholder="Stock Quantity" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="StockQuantity" class="text-red-600 p-2"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Product Features</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>
                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label asp-for="Weight" class="block text-sm/6 font-medium theme-label">Weight</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="Weight" type="text" placeholder="Weight" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">kg</span>
                            </div>
                            <span asp-validation-for="Weight" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Lenght" class="block text-sm/6 font-medium theme-label">Length</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="Lenght" type="text" placeholder="Length" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">cm</span>
                            </div>
                            <span asp-validation-for="Lenght" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Width" class="block text-sm/6 font-medium theme-label">Width</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="Width" type="text" placeholder="Width" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">cm</span>
                            </div>
                            <span asp-validation-for="Width" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Height" class="block text-sm/6 font-medium theme-label">Height</label>
                        <div class="mt-2">
                            <div class="flex">
                                <input asp-for="Height" type="text" placeholder="Height" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span class="input-helper">cm</span>
                            </div>
                            <span asp-validation-for="Height" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Attribute" class="block text-sm/6 font-medium theme-label">Material</label>
                        <div class="mt-2">
                            <input asp-for="Attribute" type="text" placeholder="Material" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="Attribute" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Color" class="block text-sm/6 font-medium theme-label">Color</label>
                        <div class="mt-2">
                            <select asp-for="Color" asp-items="Model.Colors"
                                    class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6">
                                <option value="">-- Select Color --</option>
                            </select>
                            <span asp-validation-for="Color" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-6">
                            <label asp-for="ShowInSelected" class="block text-sm/6 font-medium theme-label">
                                Show in Featured Products ?
                            </label>
                            <input type="hidden" name="ShowInSelected" id="ShowInSelectedHidden" value="@Model.ShowInSelected.ToString().ToLower()" />
                            <a href="javascript:void(0);"
                               id="ShowInSelectedBtn"
                               class="status-input space-x-5 @(Model.ShowInSelected ? "status-active" : "status-inactive")"
                               onclick="toggleShowInSelected()">
                                @(Model.ShowInSelected ? "Yes" : "No")
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Product Photos</h2>
                <p class="mt-1 text-sm/6 text-gray-600">You can upload a maximum of 12 photos.</p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <div id="photoGrid" class="grid grid-cols-4 gap-4 mb-6">
                            @if (Model.Images != null)
                            {
                                foreach (var img in Model.Images)
                                {
                                    <div class="photo-card relative" data-id="@img.Id">
                                        <button type="button" class="delete-photo absolute top-1 right-1 bg-white text-red-500 rounded-full w-6 h-6 text-sm flex items-center justify-center shadow">✕</button>
                                        <img src="@img.DataUri" class="w-full object-cover rounded" />
                                        <button type="button" class="main-tag @(Model.MainPhotoId == img.Id ? "selected" : "")" data-id="@img.Id">
                                            Main
                                        </button>
                                    </div>
                                    <input type="hidden" name="ExistingImageIds" value="@img.Id" class="existing-id-input" />
                                }
                            }
                            <!-- JS ile eklenecek -->
                        </div>
                    </div>
                </div>

                <div class="mt-6 text-center">
                    <input type="file" id="uploadFiles" name="UploadFiles" multiple accept="image/*" class="hidden" />

                    <label for="uploadFiles" class="inline-flex items-center px-4 py-2 primary-input text-sm font-medium rounded-lg cursor-pointer transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1M12 12v6m0-6l-3 3m3-3l3 3M12 6v6" />
                        </svg>
                        Select or Drag a Photo
                    </label>

                    <div id="dropZone" class="mt-4 flex flex-col items-center justify-center p-6 border-2 border-dashed rounded-lg text-gray-500 primary-border transition">
                        <p class="text-sm">Drag the files here or click the button.</p>
                    </div>

                    <ul id="fileList" class="mt-3 space-y-1 text-sm text-gray-700"></ul>
                </div>

                <div class="sm:col-span-4">
                    <div class="flex items-center space-x-4">
                        <small class="info-text">
                            <i class='bx bx-info-circle'></i>
                            Selecting a main photo that users will see is mandatory. <br />
                        </small>
                    </div>
                </div>

                <input type="hidden" id="MainPhotoId" name="MainPhotoId" value="@Model.MainPhotoId" />
                <input type="hidden" id="MainPhotoIndex" name="MainPhotoIndex" value="@Model.MainPhotoIndex" />
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Data Informations</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <input type="hidden" asp-for="CreatedBy" />
                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label asp-for="CreatedUser.UserName" class="block text-sm/6 font-medium theme-label">Created By User</label>
                        <div class="mt-2">
                            <input asp-for="CreatedUser.UserName" type="text" disabled placeholder="Created By User" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="CreatedUser.UserName" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="CreatedAt" class="block text-sm/6 font-medium theme-label">Creation Date</label>
                        <div class="mt-2">
                            <input type="text" name="CreatedAt" disabled value="@(Model.CreatedAt.ToString("dd.MM.yyyy HH.mm.ss") ?? String.Empty)" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="CreatedAt" class="text-red-600"></span>
                        </div>
                    </div>

                    @if (Model.UpdatedUser != null && !string.IsNullOrEmpty(Model.UpdatedUser.UserName))
                    {
                        <div class="sm:col-span-3">
                            <label asp-for="UpdatedUser.UserName" class="block text-sm/6 font-medium theme-label">Last Updated by User</label>
                            <div class="mt-2">
                                <input asp-for="UpdatedUser.UserName" type="text" disabled placeholder="Last Updated by User" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span asp-validation-for="UpdatedUser.UserName" class="text-red-600"></span>
                            </div>
                        </div>

                        <div class="sm:col-span-3">
                            <label asp-for="UpdatedAt" class="block text-sm/6 font-medium theme-label">Last Updated Date</label>
                            <div class="mt-2">
                                <input type="text" name="UpdatedAt" disabled value="@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH.mm.ss") ?? String.Empty)" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span asp-validation-for="UpdatedAt" class="text-red-600"></span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-6">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="text-sm/6 font-semibold theme-label">Cancel</a>
                <button type="submit" class="primary-btn rounded-md px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2">Save</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
          document.addEventListener('DOMContentLoaded', () => {
            // ——— Element referansları ———
            const purchaseExcl  = document.getElementById('purchaseExcl');
            const purchaseIncl  = document.getElementById('purchaseIncl');
            const saleExcl      = document.getElementById('saleExcl');
            const saleIncl      = document.getElementById('saleIncl');
            const taxRate       = document.getElementById('taxRate');
            const otv           = document.getElementById('otv');
            const discountRate  = document.getElementById('DiscountRate');
            const discountEnd   = document.getElementById('DiscountEndAt');
            const isDiscHidden  = document.getElementById('IsDiscountActiveHidden');
            const isDiscBtn  = document.getElementById('IsDiscountActiveBtn');
            const salePrice     = document.getElementById('salePrice');

            const upload        = document.getElementById('uploadFiles');
            const grid          = document.getElementById('photoGrid');
            const dropZone      = document.getElementById('dropZone');
            const mainIndexEl   = document.getElementById('MainPhotoIndex');
            const mainIdEl      = document.getElementById('MainPhotoId');

            // Son değiştirilen satış/alış alanını tutar
            let lastEdited = null; // 'pExcl','pIncl','sExcl','sIncl'

            // Helper: grid'deki kartları al
            const existingEls = () => Array.from(grid.querySelectorAll('.photo-card'));

            function parseDecimal(value) {
                if (!value) return 0;

                // 1.000,50 → 1000.50
                const normalized = value.replace(/\./g, '').replace(',', '.');
                const parsed = parseFloat(normalized);

                return isNaN(parsed) ? 0 : parsed;
            }

            function formatDecimal(value, fractionDigits = 2) {
                return value?.toLocaleString('tr-TR', {
                    minimumFractionDigits: fractionDigits,
                    maximumFractionDigits: fractionDigits
                }) ?? "0,00";
            }

            function recalcAll() {
                // Kullanıcının girdiği değerleri parseDecimal fonksiyonu ile sayıya çeviriyoruz.
                // Bu sayede 1.000,50 gibi değerler 1000.50 olarak işleniyor.
                const pEx = parseDecimal(purchaseExcl.value)    || 0;
                const sEx = parseDecimal(saleExcl.value)        || 0;
                const t   = parseDecimal(taxRate.value)         || 0;
                const o   = parseDecimal(otv.value)             || 0;
                const d   = parseDecimal(discountRate.value)    || 0;
                const factor = 1 + (t + o) / 100;

                // Alış: çift yönlü
                if (lastEdited === 'pExcl') {
                    // Hesaplama sonrası değeri formatDecimal ile UI için biçimlendiriyoruz.
                    purchaseIncl.value = formatDecimal(pEx * factor);
                } else if (lastEdited === 'pIncl') {
                    const pIn = parseDecimal(purchaseIncl.value) || 0;
                    purchaseExcl.value = formatDecimal(pIn / factor);
                } else {
                    purchaseIncl.value = formatDecimal(pEx * factor);
                }

                // Satış: çift yönlü
                if (lastEdited === 'sExcl') {
                    saleIncl.value = formatDecimal(sEx * factor);
                } else if (lastEdited === 'sIncl') {
                    const sIn = parseDecimal(saleIncl.value) || 0;
                    saleExcl.value = formatDecimal(sIn / factor);
                } else {
                    saleIncl.value = formatDecimal(sEx * factor);
                }

                // İndirimli son fiyat
                const now     = new Date();
                const endDate = discountEnd.value ? new Date(discountEnd.value) : null;
                let final     = parseDecimal(saleIncl.value) || 0;
                if (isDiscHidden.value === 'true' && d > 0 && endDate && now <= endDate) {
                  final = final * (1 - d / 100);
                }

                salePrice.value = final.toFixed(2);
            }

            // Fiyat event’leri
            purchaseExcl.addEventListener('input', () => { lastEdited = 'pExcl'; recalcAll(); });
            purchaseIncl.addEventListener('input', () => { lastEdited = 'pIncl'; recalcAll(); });
            saleExcl.addEventListener('input',     () => { lastEdited = 'sExcl'; recalcAll(); });
            saleIncl.addEventListener('input',     () => { lastEdited = 'sIncl'; recalcAll(); });
            isDiscBtn.addEventListener('click',     () => { recalcAll(); });

            [taxRate, otv, discountRate, discountEnd].forEach(el =>
              el.addEventListener('input', () => recalcAll())
            );

            recalcAll();

            // ——— Fotoğraf işlemleri ———
            function handleFiles(files) {
                const existingCount = existingEls().length;
                if (existingCount + files.length > 12) {
                    toastr.error('You can upload a maximum of 12 photos.');
                    return;
                }

                files.forEach(file => {
                    if (!file.type.startsWith('image/')) return;
                    const reader = new FileReader();
                    reader.onload = ev => {
                        const card = document.createElement('div');
                        card.className = 'photo-card relative';
                        card.dataset.fileName = file.name;
                         card.dataset.id = file.id || '';

                        card.innerHTML = `
                          <button type="button" class="delete-photo absolute top-1 right-1 bg-white text-red-500 rounded-full w-6 h-6 text-sm flex items-center justify-center shadow">✕</button>
                          <img src="${ev.target.result}" class="w-full object-cover rounded" />
                          <button type="button" class="main-tag ${(file.id && mainIdEl.value === file.id) ? 'selected' : ''}">Main</button>
                        `;
                        grid.appendChild(card);
                    };
                    reader.readAsDataURL(file);
                });
            }

            upload.addEventListener('change', e => handleFiles(Array.from(e.target.files)));
            ['dragenter','dragover'].forEach(evt =>
                dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('border-indigo-500','bg-indigo-50'); })
            );
            ['dragleave','drop'].forEach(evt =>
                dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('border-indigo-500','bg-indigo-50'); })
            );
            dropZone.addEventListener('drop', e => {
                const dtFiles = Array.from(e.dataTransfer.files);
                const dt = new DataTransfer();
                Array.from(upload.files).forEach(f => dt.items.add(f));
                dtFiles.forEach(f => dt.items.add(f));
                upload.files = dt.files;
                handleFiles(dtFiles);
            });

            grid.addEventListener('click', e => {
                const del = e.target.closest('.delete-photo');
                if (del) {
                    const card = del.closest('.photo-card');
                    const imageId = card.dataset.id;

                    const upload = document.getElementById('UploadFiles');
                    if (upload && upload.files) {
                        const name = card.dataset.fileName;
                        const dt = new DataTransfer();
                        Array.from(upload.files).forEach(f => { if (f.name!== name) dt.items.add(f); });
                        upload.files = dt.files;
                    }

                    if (imageId) {
                        const existingIdInput = document.querySelector(`input.existing-id-input[value="${imageId}"]`);
                        if (existingIdInput) {
                            existingIdInput.remove();
                        }
                    }

                    card.remove();

                    if (card.querySelector('.main-tag.selected')) {
                        mainIndexEl.value = '';
                        mainIdEl.value = '';
                    }
                    return;
                }

                const btn = e.target.closest('button.main-tag');
                if (!btn) return;
                grid.querySelectorAll('button.main-tag').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');

                const cards = existingEls();
                const card  = btn.closest('.photo-card');
                const idx   = cards.indexOf(card);
                mainIndexEl.value = idx;
                mainIndexEl.setAttribute('value', idx);

                const id = card.dataset.id || '';
                mainIdEl.value = id;
                mainIdEl.setAttribute('value', id);
            });
        });

        // IsActive Toggle
        function toggleStatus() {
            var btn = document.getElementById('statusToggleBtn');
            var hiddenInput = document.getElementById('IsActiveHidden');
            var isActive = hiddenInput.value === 'true';

            if (isActive) {
                btn.classList.remove('status-active');
                btn.classList.add('status-inactive');
                btn.textContent = 'Pasif';
                hiddenInput.value = 'false';
            } else {
                btn.classList.remove('status-inactive');
                btn.classList.add('status-active');
                btn.textContent = 'Aktif';
                hiddenInput.value = 'true';
            }
        }

        // Is Discount Active Toggle
        function toggleIsDiscountActive() {
            const btn = document.getElementById('IsDiscountActiveBtn');
            const hidden = document.getElementById('IsDiscountActiveHidden');
            const fields = [
                document.getElementById('discountField1'),
                document.getElementById('discountField2'),
                document.getElementById('discountField3')
            ];

            const isActive = hidden.value.toLowerCase() === 'true';

            if (!isActive) {
                btn.classList.remove('status-inactive');
                btn.classList.add('status-active');
                btn.textContent = 'Evet';
                fields.forEach(f => f.style.display = 'block');
            } else {
                btn.classList.remove('status-active');
                btn.classList.add('status-inactive');
                btn.textContent = 'Hayır';
                fields.forEach(f => f.style.display = 'none');
            }

            hidden.value = (!isActive).toString();
        }

        // Stock Tracking Toggle
        function toggleStockTracking() {
            const btn = document.getElementById('StockTrackingBtn');
            const hidden = document.getElementById('StockTrackingHidden');
            const fields = [document.getElementById('criticalStockField')];

            const isActive = hidden.value.toLowerCase() === 'true';

            if (!isActive) {
                btn.classList.remove('status-inactive');
                btn.classList.add('status-active');
                btn.textContent = 'Evet';
                fields.forEach(f => f.style.display = 'block');
            } else {
                btn.classList.remove('status-active');
                btn.classList.add('status-inactive');
                btn.textContent = 'Hayır';
                fields.forEach(f => f.style.display = 'none');
            }

            hidden.value = (!isActive).toString();
        }

        // Show In Selected Toggle
        function toggleShowInSelected() {
            var btn = document.getElementById('ShowInSelectedBtn');
            var hiddenInput = document.getElementById('ShowInSelectedHidden');
            var isActive = hiddenInput.value === 'true';

            if (isActive) {
                btn.classList.remove('status-active');
                btn.classList.add('status-inactive');
                btn.textContent = 'Hayır';
                hiddenInput.value = 'false';
            } else {
                btn.classList.remove('status-inactive');
                btn.classList.add('status-active');
                btn.textContent = 'Evet';
                hiddenInput.value = 'true';
            }
        }

        $(document).ready(function () {
            $('form').on('submit', function (e) {
                e.preventDefault();
                var formEl = this;
                var formData = new FormData(formEl);
                var token = $('input[name="__RequestVerificationToken"]', formEl).val();
                formData.set("__RequestVerificationToken", token);

                showConfirmationModal('Are you sure you want to save the product?', function () {
                    $.ajax({
                        url: formEl.action,
                        type: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        headers: {
                          'RequestVerificationToken': token
                        },
                        success: function (response) {
                          if (response.success) {
                            toastr.success(response.message || 'Saved successfully.');
                            setTimeout(function () {
                              window.location.href = '/Admin/Product/Index';
                            }, 3000);
                          } else {
                            toastr.error(response.message || 'An error occured.');
                          }
                        },
                        error: function (xhr) {
                            console.error('Error Code:', xhr.status, 'Sent token:', token);
                            toastr.error('An error occured (Code ' + xhr.status + ')');
                        }
                    });
                });
            });
        });
    </script>
}