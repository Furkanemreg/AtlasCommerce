@using AtlasCommerce.Application.ViewModels
@{
    ViewData["Title"] = $"Yönetim Paneli - {Model?.Settings?.BrandName}";
    Layout = "_Layout";
}

@model DashboardVM

<!-- MAIN -->
<main>
    <div class="head-title">
        <div class="left">
            <h1>Yönetim Paneli</h1>
            <ul class="breadcrumb">
                <li>
					<a href="#">Yönetim Paneli</a>
				</li>
				<li><i class='bx bx-chevron-right'></i></li>
				<li>
					<a asp-controller="Home" asp-action="Index">Atlas Commerce</a>
				</li>
            </ul>
        </div>
        <a href="#" class="btn-download">
			<i class='bx bxs-cloud-download'></i>
			<span class="text">PDF İndir</span>
		</a>
    </div>

    <ul class="box-info">
        <li>
            <i class='bx bxs-calendar-check'></i>
            <span class="text">
                <h3>0</h3> @* Modelden Gelecek *@
                <p>Toplam Sipariş</p>
            </span>
        </li>
        <li>
            <i class='bx  bx-basket'></i>
            <span class="text">
                <h3>@Model.TotalProductCount</h3> @* Modelden Gelecek *@
                <p>Toplam Ürün</p>
            </span>
        </li>
        <li>
            <i class='bx bxs-dollar-circle'></i>
            <span class="text">
                <h3>0.00 ₺</h3> @* Modelden Gelecek *@
                <p>Toplam Satış</p>
            </span>
        </li>
    </ul>


    <div class="table-data">
        <div class="order">
            <div class="head">
                <h3>Son Siparişler</h3>
                <i class='bx bx-search'></i>
                <i class='bx bx-filter'></i>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>Sipariş Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @* <tr>
						<td>
							<img src="img/people.png">
							<p>John Doe</p>
						</td>
						<td>01-10-2021</td>
						<td><span class="status completed">Completed</span></td>
					</tr>
					<tr>
						<td>
							<img src="img/people.png">
							<p>John Doe</p>
						</td>
						<td>01-10-2021</td>
						<td><span class="status pending">Pending</span></td>
					</tr>
					<tr>
						<td>
							<img src="img/people.png">
							<p>John Doe</p>
						</td>
						<td>01-10-2021</td>
						<td><span class="status process">Process</span></td>
					</tr>
					<tr>
						<td>
							<img src="img/people.png">
							<p>John Doe</p>
						</td>
						<td>01-10-2021</td>
						<td><span class="status canceled">Canceled</span></td>
					</tr>
					<tr>
						<td>
							<img src="img/people.png">
							<p>John Doe</p>
						</td>
						<td>01-10-2021</td>
						<td><span class="status completed">Completed</span></td>
					</tr> *@
                </tbody>
            </table>
        </div>
        <div class="todo">
            <div class="head">
                <h3>Mesajlar</h3>
                @* <i class='bx bx-search'></i> *@
            </div>
            <ul class="todo-list">
                @if (Model.DashboardMessages != null && Model.DashboardMessages.Count > 0)
                {
                    @foreach (var message in Model.DashboardMessages)
                    {
                        @if (message.IsRead != true)
                        {
                            <li class="not-completed">
                                <p>@message.FirstName @message.LastName - @message.Topic</p>
                                <a href="#" class="btnViewMessage" data-id="@message.MessageId">
                                    <i class='bx bx-show' style="cursor: pointer;color: var(--dark);"></i>
                                </a>
                                @* <a asp-controller="Message" asp-action="View" asp-route-id="@message.MessageId">
									<i class='bx bx-show' style="cursor: pointer;color: var(--dark);"></i>
								</a> *@
                            </li>
                        }
                        else
                        {
                            <li class="completed">
                                <p>@message.FirstName @message.LastName - @message.Topic</p>
                                <a href="#" class="btnViewMessage" data-id="@message.MessageId">
                                    <i class='bx bx-show'></i>
                                </a>
                            </li>
                        }
                    }
                }
                else
                {
                    <li class="empty-message">
                        <div style="color: #888;">
                            <p><i class='bx bx-message-square-x me-2'></i>Yanıtlanmamış mesajınız bulunmuyor.</p>
                        </div>
                    </li>
                }
            </ul>
            <div class="view-all-messages" style="margin-top: 15px; text-align: center;">
                <a asp-area="Admin" asp-controller="Message" asp-action="Index" class=" btn primary-btn">
                    Tümünü Görüntüle
                </a>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #337ab7; color: white;">
                <h5 class="modal-title" id="messageModalLabel">Mesaj Detayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2"><strong>Ad Soyad:</strong> <span id="modalFullName" style="word-break: break-word;"></span></p>
                <p class="mb-2"><strong>Email Adresi:</strong> <span id="modalEmailAddress" style="word-break: break-word;"></span></p>
                <p class="mb-2"><strong>Mesaj Tarihi:</strong> <span id="modalMessageDate" style="word-break: break-word;"></span></p>
                <p class="mb-2"><strong>Konu:</strong> <span id="modalTopic" style="word-break: break-word;"></span></p>
                <p class="mb-2" style="margin-bottom: 0;"><strong>Mesaj:</strong> <span id="modalContent" style="white-space: pre-wrap; word-break: break-word;"></span></p>
            </div>

            <div class="modal-footer flex-column align-items-stretch">

                <div class="w-100 mb-2">
                    <label class="form-label"><strong>Yanıt</strong></label>
                    <textarea id="modalReplyInput" class="form-control" rows="3" placeholder="Yanıtınız..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 w-100">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-primary" id="btnSendReply">
                        Yanıtla
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let currentMessageId = null;

        const messageModalEl = document.getElementById("messageModal");
        const messageModal = new bootstrap.Modal(messageModalEl);

        document.querySelectorAll(".btnViewMessage").forEach(el => {
            el.addEventListener("click", async function (e) {
                e.preventDefault();
                const id = this.getAttribute("data-id");
                currentMessageId = id;

				try {
					const response = await fetch(`/Message/ViewMessage?id=${id}`);
					if (!response.ok) throw new Error("Mesaj yüklenemedi.");

                    const data = await response.json();

                    document.getElementById("modalFullName").textContent = `${data.name} ${data.surname}`;
                    document.getElementById("modalEmailAddress").textContent = data.emailaddress;
                    document.getElementById("modalMessageDate").textContent = data.messagedate;
                    document.getElementById("modalTopic").textContent = data.topic;
                    document.getElementById("modalContent").textContent = data.message;

                    messageModal.show();

                } catch (error) {
                    alert("Hata: " + error.message);
                }
            });
        });

        document.getElementById("btnSendReply").addEventListener("click", async function () {

            const reply = document.getElementById("modalReplyInput").value;

            if (!reply || reply.trim() === "") {
                toastr.error("Mesaj yanıtı boş olamaz.");
                return;
            }

            const response = await fetch("/Message/ReplyMessage", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    messageId: currentMessageId,
                    reply: reply
                })
            });

            if (response.ok) {
                toastr.success("Mesaj yanıtınız gönderildi.");
                document.getElementById("modalReplyInput").value = "";
                messageModal.hide();
                location.reload();
            } else {
                toastr.error("Yanıt gönderilemedi.");
            }
        });
    });
</script>