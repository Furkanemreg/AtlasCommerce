@using AtlasCommerce.Application.Interfaces
@using AtlasCommerce.Domain.Entities
@model AtlasCommerce.Application.ViewModels.WebsiteSettingsVM
@inject IBaseService<WebsiteFeature> _featureService
@inject IBaseService<WebsiteService> _serviceService
@inject IBaseService<WebsiteBanner> _bannerService

@{
    Layout = "_SettingsLayout";
    ViewData["Title"] = "Settings";
    var _websiteFeatures = await _featureService.GetAllAsync();
    var _websiteServices = await _serviceService.GetAllAsync();
    var _websiteBanners = await _bannerService.GetAllAsync();
}

<link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

<div class="max-w-4xl mx-auto rounded-md my-5">
    <form asp-controller="Setting" asp-action="Save" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="space-y-12">
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">General Settings</h2>
                <p class="mt-1 text-sm/6 text-gray-600">You can configure basic website settings here.</p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">

                    <div class="sm:col-span-4">
                        <label asp-for="BrandName" class="block text-sm/6 font-medium theme-label">Brand Name</label>
                        <div class="mt-2">
                            <input asp-for="BrandName" type="text" placeholder="Brand Name" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="PhoneNumber" class="block text-sm/6 font-medium theme-label">Phone Number</label>
                        <div class="mt-2">
                            <input asp-for="PhoneNumber" type="text" placeholder="Phone Number" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="EmailAddress" class="block text-sm/6 font-medium theme-label">e-Mail Address</label>
                        <div class="mt-2">
                            <input asp-for="EmailAddress" type="email" placeholder="e-Mail Address" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>

                    <div class="sm:col-span-6">
                        <label asp-for="Address" class="block text-sm/6 font-medium theme-label">Full Address</label>
                        <div class="mt-2">
                            <textarea asp-for="Address" rows="3" placeholder="Full Address" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm"></textarea>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-6">
                            <small class="info-text">
                                <i class='bx bx-info-circle'></i>
                                This will be used as the delivery address for in-store pickup orders.
                            </small>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="Country" class="block text-sm/6 font-medium theme-label">Country</label>
                        <div class="mt-2">
                            <input asp-for="Country" type="text" placeholder="Türkiye" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>
                    <div class="sm:col-span-3">
                        <label asp-for="City" class="block text-sm/6 font-medium theme-label">City</label>
                        <div class="mt-2">
                            <input asp-for="City" type="text" placeholder="İstanbul" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>
                    <div class="sm:col-span-3">
                        <label asp-for="District" class="block text-sm/6 font-medium theme-label">District</label>
                        <div class="mt-2">
                            <input asp-for="District" type="text" placeholder="Kağıthane" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>
                    <div class="sm:col-span-3">
                        <label asp-for="ZipCode" class="block text-sm/6 font-medium theme-label">Zip Code</label>
                        <div class="mt-2">
                            <input asp-for="ZipCode" type="text" placeholder="34408" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>

                    <div class="sm:col-span-6">
                        <label class="block text-sm/6 font-medium theme-label">Logo</label>
                        <div class="mt-2 flex items-center space-x-4">
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <img src="@Model.LogoPath" alt="Logo" class="h-16 rounded shadow" />
                            }
                            <input type="file" name="LogoFile" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        </div>
                    </div>

                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">About Us</h2>
                <p class="mt-1 text-sm/6 text-gray-600">You can manage the main paragraph and sub-clauses of the About Us page from here.</p>

                <div class="sm:col-span-4">
                    <div class="flex items-center space-x-6">
                        <small class="info-text">
                            <i class='bx bx-info-circle'></i>
                            You can add HTML tags to sentences. (Ex. <code>&lt;strong&gt;<strong>FURKAN EMRE GİNYOL</strong>&lt;/strong&gt;</code>)
                        </small>
                    </div>
                </div>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-6">
                        <label asp-for="AboutParagraph" class="block text-sm/6 font-medium theme-label">About Us - Main Paragraph</label>
                        <input asp-for="AboutParagraph" type="text" 
                                placeholder="AtlasCommerce is a modern and integrated e-commerce platform developed for Istanbul Atlas University."
                                class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>

                    <div class="sm:col-span-6">
                        <label asp-for="AboutAltSentence1" class="block text-sm/6 font-medium theme-label">About Us - Sub Sentence 1</label>
                        <input asp-for="AboutAltSentence1" type="text"
                               placeholder="The platform enables online product management, ordering, and user operations within a single system."
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>

                    <div class="sm:col-span-6">
                        <label asp-for="AboutAltSentence2" class="block text-sm/6 font-medium theme-label">About Us - Sub Sentence 2</label>
                        <input asp-for="AboutAltSentence2" type="text" 
                                placeholder="It provides a secure and user-friendly digital commerce experience for both customers and administrators."
                                class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Contact & Social Media</h2>
                <p class="mt-1 text-sm/6 text-gray-600">You can manage social media links and footer settings from here.</p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-6">
                        <label asp-for="FooterText" class="block text-sm/6 font-medium theme-label">Footer Text</label>
                        <input asp-for="FooterText" type="text" placeholder="Footer Text" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="Instagram" class="block text-sm/6 font-medium theme-label">Instagram</label>
                        <input asp-for="Instagram" type="text" placeholder="Instagram" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="Twitter" class="block text-sm/6 font-medium theme-label">Twitter</label>
                        <input asp-for="Twitter" type="text" placeholder="Twitter" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="Youtube" class="block text-sm/6 font-medium theme-label">YouTube</label>
                        <input asp-for="Youtube" type="text" placeholder="YouTube" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                    </div>
                </div>
            </div>


            <!-- Features -->
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Feature Tabs</h2>
                <p class="mt-1 text-sm/6 text-gray-600">
                    <i class="ri-error-warning-line"></i>
                    You can manage the icons, titles, and descriptions that will be displayed on your site from here.
                </p>
                <p class="mt-1 text-sm/6 text-gray-600">
                    <i class="ri-error-warning-line"></i>
                    <a href="https://remixicon.com/" style="color: #337ab7;" target="_blank">Click here to access icons you can use on your website.</a>
                </p>

                <!-- Feature List -->
                <div class="mt-6">
                    @if (_websiteFeatures != null && _websiteFeatures.Any())
                    {
                        <ul class="divide-y divide-gray-200">
                            @foreach (var feature in _websiteFeatures)
                            {
                                <li class="py-2 flex items-center justify-between" data-id="@feature.Id">
                                    <span>
                                        <i class="@feature.IconHtml" style="font-size: 1.5rem;"></i>
                                        <strong class="ml-1">@feature.Title</strong> - @feature.Text
                                    </span>
                                    <button type="button" class="delete-feature text-red-600 text-sm">Delete</button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-gray-500 text-sm">No feature tabs have been added yet.</p>
                    }
                </div>

                <button type="button" id="btnAddFeature"
                        class="mt-4 px-4 py-2 rounded-md bg-green-600 text-white">
                    Add New Feature Tab
                </button>
            </div>


            <!-- Services -->
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Our Services Tabs</h2>
                <p class="mt-1 text-sm/6 text-gray-600">
                    You can manage the service cards displayed on your “Our Services” page from this section.
                </p>

                <!-- Service List -->
                <div class="mt-6">
                    @if (_websiteServices != null && _websiteServices.Any())
                    {
                        <ul class="divide-y divide-gray-200">
                            @foreach (var service in _websiteServices)
                            {
                                <li class="py-2 flex items-center justify-between" data-id="@service.Id">
                                    <span>
                                        <img src="@Url.Content(string.IsNullOrEmpty(service.ImagePath) ? "~/img/placeholder.jpg" : service.ImagePath)"
                                             alt="@service.Title"
                                             class="w-10 h-10 object-cover rounded-md border border-gray-200"
                                             loading="lazy" />
                                        <strong>@service.Title</strong>
                                        <p>@service.Text</p>
                                    </span>
                                    <button type="button" class="delete-service text-red-600 text-sm">Delete</button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-gray-500 text-sm">No service tabs have been added yet.</p>
                    }
                </div>

                <button type="button" id="btnAddService"
                        class="mt-4 px-4 py-2 rounded-md bg-green-600 text-white">
                    Add New Service Tab
                </button>
            </div>


            <!-- Banners -->
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Banner Settings</h2>
                <p class="mt-1 text-sm/6 text-gray-600">
                    You can manage the cards (banners) that will be displayed on your website's homepage from this section.
                </p>

                <!-- Banner List -->
                <div class="mt-6">
                    @if (_websiteBanners != null && _websiteBanners.Any())
                    {
                        <ul class="divide-y divide-gray-200">
                            @foreach (var banner in _websiteBanners)
                            {
                                <li class="py-2 flex items-center justify-between" data-id="@banner.Id">
                                    <span>
                                        <img src="@Url.Content(string.IsNullOrEmpty(banner.ImagePath) ? "~/img/placeholder.jpg" : banner.ImagePath)"
                                             alt="@banner.Title"
                                             class="w-10 h-10 object-cover rounded-md border border-gray-200"
                                             loading="lazy" />
                                        <strong>@banner.Title</strong>
                                        <p>@banner.Text</p>
                                    </span>
                                    <button type="button" class="delete-banner text-red-600 text-sm">Delete</button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-gray-500 text-sm">No banners have been added yet.</p>
                    }
                </div>

                <button type="button" id="btnAddBanner"
                        class="mt-4 px-4 py-2 rounded-md bg-green-600 text-white">
                    Add New Banner
                </button>
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-6">
                <a asp-controller="Home" asp-action="Index" class="text-sm/6 font-semibold theme-label">Cancel</a>
                <button type="submit" class="primary-btn rounded-md px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2">Save</button>
            </div>
        </div>
    </form>
</div>

<!-- Feature Modal -->
<div id="featureModal" class="fixed inset-0 hidden bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">New Feature Tab</h3>
        <form method="post" asp-controller="Setting" asp-action="AddFeature">
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Icon HTML</label>
                <input type="text" name="IconHtml" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
                <small class="text-gray-500">
                    Only write class names and styling-related values <br />
                    (e.g. <code>ri-tools-line text-primary</code>).
                </small>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Title</label>
                <input type="text" name="Title" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Description</label>
                <textarea name="Text" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50"></textarea>
            </div>

            <div class="flex justify-end space-x-2">
                <button type="button" id="cancelFeatureModal" class="px-4 py-2 bg-gray-200 rounded-md">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Service Modal -->
<div id="serviceModal" class="fixed inset-0 hidden bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">New Feature Tab</h3>
        <form method="post" enctype="multipart/form-data" asp-controller="Setting" asp-action="AddService">
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Image</label>
                <input type="file" name="ImageFile" accept="image/*" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Title</label>
                <input type="text" name="Title" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Description</label>
                <textarea name="Text" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50"></textarea>
            </div>
            <div class="flex justify-end space-x-2">
                <button type="button" id="cancelServiceModal" class="px-4 py-2 bg-gray-200 rounded-md">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Banner Modal -->
<div id="bannerModal" class="fixed inset-0 hidden bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">New Banner Tab</h3>
        <form method="post" enctype="multipart/form-data" asp-controller="Setting" asp-action="AddBanner">
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Image</label>
                <input type="file" name="ImageFile" accept="image/*" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Title</label>
                <input type="text" name="Title" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1">Description</label>
                <textarea name="Text" class="w-full border rounded-md px-3 py-2 text-sm bg-gray-50"></textarea>
            </div>
            <div class="flex justify-end space-x-2">
                <button type="button" id="cancelBannerModal" class="px-4 py-2 bg-gray-200 rounded-md">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Confirm Delete Modal -->
<div id="confirmDeleteModal" class="fixed inset-0 hidden bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm text-center">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Delete Confirmation</h3>
        <p class="text-gray-600 mb-6">
            You are about to permanently delete this record. <br />
            Do you want to continue?
        </p>
        <div class="flex justify-center space-x-3">
            <button id="cancelDelete" class="px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300">
                Cancel
            </button>
            <button id="confirmDelete" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
                Yes
            </button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
    /* Website Features */
    const btnAddFeature = document.getElementById("btnAddFeature");
    const featureModal = document.getElementById("featureModal");
    const cancelFeatureModal = document.getElementById("cancelFeatureModal");

    btnAddFeature?.addEventListener("click", () => {
        featureModal.classList.remove("hidden");
        featureModal.classList.add("flex");
    });

    cancelFeatureModal?.addEventListener("click", () => {
        featureModal.classList.remove("flex");
        featureModal.classList.add("hidden");
    });


    /* Website Services */
    const btnAddService = document.getElementById("btnAddService");
    const serviceModal = document.getElementById("serviceModal");
    const cancelServiceModal = document.getElementById("cancelServiceModal");

    btnAddService?.addEventListener("click", () => {
        serviceModal.classList.remove("hidden");
        serviceModal.classList.add("flex");
    });

    cancelServiceModal?.addEventListener("click", () => {
        serviceModal.classList.remove("flex");
        serviceModal.classList.add("hidden");
    });


    /* Website Banners */
    const btnAddBanner = document.getElementById("btnAddBanner");
    const bannerModal = document.getElementById("bannerModal");
    const cancelBannerModal = document.getElementById("cancelBannerModal");

    btnAddBanner?.addEventListener("click", () => {
        bannerModal.classList.remove("hidden");
        bannerModal.classList.add("flex");
    });

    cancelBannerModal?.addEventListener("click", () => {
        bannerModal.classList.remove("flex");
        bannerModal.classList.add("hidden");
    });
</script>
<script>
    $(document).ready(function () {
        /* Website Features */
        let featureToDelete = null;

        const $confirmModal = $("#confirmDeleteModal");
        const $cancelBtn = $("#cancelDelete");
        const $confirmBtn = $("#confirmDelete");

        $(".delete-feature").on("click", function () {
            featureToDelete = $(this).closest("[data-id]");
            $confirmModal.removeClass("hidden").addClass("flex");
        });

        $cancelBtn.on("click", function () {
            $confirmModal.removeClass("flex").addClass("hidden");
            featureToDelete = null;
        });

        $confirmBtn.on("click", function () {
            if (!featureToDelete) return;

            const featureId = featureToDelete.data("id");
            $confirmModal.removeClass("flex").addClass("hidden");

            $.ajax({
                url: '/Admin/Setting/DeleteFeature',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ id: featureId }),
                success: function (data) {
                    if (data.success) {
                        featureToDelete.remove();
                        toastr.success(data.message);
                    } else {
                        toastr.error(data.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("An error occurred while deleting the record: ", error);
                    toastr.error("An error occurred while deleting the record.");
                }
            });
        });        

        /* Website Services */
        let serviceToDelete = null;

        $(".delete-service").on("click", function () {
            serviceToDelete = $(this).closest("[data-id]");
            $confirmModal.removeClass("hidden").addClass("flex");
        });

        $cancelBtn.on("click", function () {
            $confirmModal.removeClass("flex").addClass("hidden");
            serviceToDelete = null;
        });

        $confirmBtn.on("click", function () {
            if (!serviceToDelete) return;

            const serviceId = serviceToDelete.data("id");
            $confirmModal.removeClass("flex").addClass("hidden");

            $.ajax({
                url: '/Admin/Setting/DeleteService',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ id: serviceId }),
                success: function (data) {
                    if (data.success) {
                        serviceToDelete.remove();
                        toastr.success(data.message);
                    } else {
                        toastr.error(data.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("An error occurred while deleting the record: ", error);
                    toastr.error("An error occurred while deleting the record.");
                }
            });
        });      

        /* Website Banners */
        let bannerToDelete = null;

        $(".delete-banner").on("click", function () {
            bannerToDelete = $(this).closest("[data-id]");
            $confirmModal.removeClass("hidden").addClass("flex");
        });

        $cancelBtn.on("click", function () {
            $confirmModal.removeClass("flex").addClass("hidden");
            bannerToDelete = null;
        });

        $confirmBtn.on("click", function () {
            if (!bannerToDelete) return;

            const bannerId = bannerToDelete.data("id");
            $confirmModal.removeClass("flex").addClass("hidden");

            $.ajax({
                url: '/Admin/Setting/DeleteBanner',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ id: bannerId }),
                success: function (data) {
                    if (data.success) {
                        bannerToDelete.remove();
                        toastr.success(data.message);
                    } else {
                        toastr.error(data.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("An error occurred while deleting the record: ", error);
                    toastr.error("An error occurred while deleting the record.");
                }
            });
        });
    });
</script>