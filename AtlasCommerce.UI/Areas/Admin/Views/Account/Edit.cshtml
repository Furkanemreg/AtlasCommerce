@using AtlasCommerce.Application.ViewModels
@{
    ViewData["Title"] = "Sistem Kullanıcıları - Ekle/Düzenle";
    Layout = "_Layout";
    var vm = Model ?? new AppUserVM();
}

@model AppUserVM

<div class="max-w-4xl mx-auto rounded-md my-5">
    <form asp-area="Admin" asp-controller="Account" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="space-y-12">
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Sistem Kullanıcısı Tanımlama</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label asp-for="UserName" class="block text-sm/6 font-medium theme-label">Kullanıcı Adı</label>
                        <div class="mt-2">
                            <input asp-for="UserName" type="text" placeholder="Kullanıcı Adı" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="UserName" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    @if (Model?.UserName == null)
                    {
                        <div class="sm:col-span-4">
                            <label asp-for="Password" class="block text-sm font-medium theme-label">Şifre</label>
                            <div class="mt-2 relative">
                                <input id="passwordInput" asp-for="Password" type="password" placeholder="Şifre" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base pr-10 sm:text-sm" />
                                <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center px-2 text-gray-500" tabindex="-1">
                                    <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-red-600"></span>
                        </div>
                    }

                    <div class="sm:col-span-4">
                        <label asp-for="Roles" class="block text-sm/6 font-medium theme-label">Kullanıcı Rolü</label>
                        <div class="mt-2">
                            <select asp-for="UserRole" asp-items="ViewBag.RoleList" class=" theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6"></select>
                            <span asp-validation-for="Roles" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="flex items-center space-x-6">
                            <label asp-for="IsActive" class="block text-sm/6 font-medium theme-label">
                                Durum
                            </label>
                            <input type="hidden" name="IsActive" id="IsActiveHidden" value="@Model.IsActive.ToString().ToLower()" />
                            <a href="javascript:void(0);"
                               id="statusToggleBtn"
                               class="status-input space-x-5 @(Model.IsActive ? "status-active" : "status-inactive")"
                               onclick="toggleStatus()">
                                @(Model.IsActive ? "Aktif" : "Pasif")
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Kişisel Bilgiler</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label asp-for="FirstName" class="block text-sm/6 font-medium theme-label">Adı</label>
                        <div class="mt-2">
                            <input asp-for="FirstName" type="text" placeholder="Adı" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="FirstName" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="LastName" class="block text-sm/6 font-medium theme-label">Soyadı</label>
                        <div class="mt-2">
                            <input asp-for="LastName" type="text" placeholder="Soyadı" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="LastName" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="Email" class="block text-sm/6 font-medium theme-label">E-Posta Adresi</label>
                        <div class="mt-2">
                            <input asp-for="Email" type="email" placeholder="E-Posta Adresi" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="Email" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="PhoneNumber" class="block text-sm/6 font-medium theme-label">Telefon Numarası</label>
                        <div class="mt-2">
                            <input asp-for="PhoneNumber" type="number" placeholder="Telefon Numarası" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="PhoneNumber" class="text-red-600"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Kayıt Bilgileri</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label asp-for="CreatedUser.UserName" class="block text-sm/6 font-medium theme-label">Oluşturan Kullanıcı</label>
                        <div class="mt-2">
                            <input asp-for="CreatedUser.UserName" type="text" disabled placeholder="Oluşturan Kullanıcı" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="CreatedUser.UserName" class="text-red-600"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="CreatedAt" class="block text-sm/6 font-medium theme-label">Oluşturulma Tarihi</label>
                        <div class="mt-2">
                            <input type="text" name="CreatedAt" disabled value="@(Model.CreatedAt?.ToString("dd.MM.yyyy HH.mm.ss") ?? String.Empty)" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="CreatedAt" class="text-red-600"></span>
                        </div>
                    </div>

                    @if (Model.UpdatedUser != null && !string.IsNullOrEmpty(Model.UpdatedUser.UserName))
                    {
                        <div class="sm:col-span-3">
                            <label asp-for="UpdatedUser.UserName" class="block text-sm/6 font-medium theme-label">Son Güncelleyen Kullanıcı</label>
                            <div class="mt-2">
                                <input asp-for="UpdatedUser.UserName" type="text" disabled placeholder="Son Güncelleyen Kullanıcı" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span asp-validation-for="UpdatedUser.UserName" class="text-red-600"></span>
                            </div>
                        </div>

                        <div class="sm:col-span-3">
                            <label asp-for="UpdatedAt" class="block text-sm/6 font-medium theme-label">Son Güncelleme Tarihi</label>
                            <div class="mt-2">
                                <input type="text" name="UpdatedAt" disabled value="@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH.mm.ss") ?? String.Empty)" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                                <span asp-validation-for="UpdatedAt" class="text-red-600"></span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-6">
                <a asp-area="Admin" asp-controller="Account" asp-action="Index" class="text-sm/6 font-semibold theme-label">İptal</a>
                <button type="submit" class="primary-btn rounded-md px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2">Kaydet</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleStatus() {
            var btn = document.getElementById('statusToggleBtn');
            var hiddenInput = document.getElementById('IsActiveHidden');
            var isActive = hiddenInput.value === 'true';

            if (isActive) {
                btn.classList.remove('status-active');
                btn.classList.add('status-inactive');
                btn.textContent = 'Pasif';
                hiddenInput.value = 'false';
            } else {
                btn.classList.remove('status-inactive');
                btn.classList.add('status-active');
                btn.textContent = 'Aktif';
                hiddenInput.value = 'true';
            }
        }

        $(document).ready(function () {
            $('form').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                var formData = $(form).serialize();

                showConfirmationModal('Kullanıcıyı kaydetmek istediğinizden emin misiniz?', function () {
                    $.ajax({
                        url: $(form).attr('action'),
                        type: 'POST',
                        data: formData,
                        success: function (response) {
                            if (response.success) {
                                toastr.success(response.message || 'Kayıt başarıyla kaydedildi');
                                setTimeout(function () {
                                    window.location.href = '/Admin/Account/Index';
                                }, 3000);
                            } else {
                                toastr.error(response.message || 'Bir hata oluştu');
                            }
                        },
                        error: function () {
                            toastr.error('Bir hata oluştu');
                        }
                    });
                });
            });

            const passwordInput = document.getElementById('passwordInput');
            const toggleButton = document.getElementById('togglePassword');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput && toggleButton && eyeIcon) {
                toggleButton.addEventListener('click', function () {
                    const isPassword = passwordInput.type === 'password';
                    passwordInput.type = isPassword ? 'text' : 'password';
                    eyeIcon.classList.toggle('text-gray-500', !isPassword);
                    eyeIcon.classList.toggle('text-gray-800', isPassword);
                });
            }
        });
    </script>
}