@using AtlasCommerce.Application.ViewModels
@{
    ViewData["Title"] = "Şifre Güncelleme";
    Layout = "_Layout";
    var vm = Model ?? new ResetPasswordVM();
}

@model ResetPasswordVM

<div class="max-w-4xl mx-auto rounded-md my-5">
    <form asp-area="Admin" asp-controller="Account" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="space-y-12">
            <div class="border-b border-gray-900/10 pb-12">
                <h2 class="text-base/7 font-semibold theme-label">Şifre Güncelleme</h2>
                <p class="mt-1 text-sm/6 text-gray-600"></p>

                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label asp-for="UserName" class="block text-sm/6 font-medium theme-label">Kullanıcı Adı</label>
                        <div class="mt-2">
                            <input asp-for="UserName" type="text" disabled placeholder="Kullanıcı Adı" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6" />
                            <span asp-validation-for="UserName" class="text-red-600 p-2"></span>
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="Password" class="block text-sm font-medium theme-label">Şifre</label>
                        <div class="mt-2 relative">
                            <input id="passwordInput" asp-for="Password" type="password" placeholder="Şifre" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base pr-10 sm:text-sm" />
                            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center px-2 text-gray-500" tabindex="-1">
                                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-600"></span>
                    </div>

                    <div class="sm:col-span-4">
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium theme-label">Şifre Onayı</label>
                        <div class="mt-2 relative">
                            <input id="confirmPasswordPasswordInput" asp-for="ConfirmPassword" type="password" placeholder="Şifre" autocomplete="off" class="theme-input block w-full rounded-md px-3 py-1.5 text-base pr-10 sm:text-sm" />
                            <button type="button" id="confirmPasswordTogglePassword" class="absolute inset-y-0 right-0 flex items-center px-2 text-gray-500" tabindex="-1">
                                <svg id="confirmPasswordEyeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-600"></span>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-6">
                <a asp-area="Admin" asp-controller="Account" asp-action="Index" class="text-sm/6 font-semibold theme-label">İptal</a>
                <button type="submit" class="primary-btn rounded-md px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2">Kaydet</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
           $('form').on('submit', function (e) {
               e.preventDefault();

               var form = this;
               var formData = $(form).serialize();

               showConfirmationModal('Güncellenen şifreyi kaydetmek istediğinizden emin misiniz?', function () {
                   $.ajax({
                       url: $(form).attr('action'),
                       type: 'POST',
                       data: formData,
                       success: function (response) {
                           if (response.success) {
                               toastr.success(response.message || 'Kayıt başarıyla kaydedildi');
                               setTimeout(function () {
                                   window.location.href = '/Admin/Account/Index';
                               }, 3000);
                           } else {
                               toastr.error(response.message || 'Bir hata oluştu');
                           }
                       },
                       error: function () {
                           toastr.error('Bir hata oluştu');
                       }
                   });
               });
           });
        });

        const passwordInput = document.getElementById('passwordInput');
        const toggleButton = document.getElementById('togglePassword');
        const eyeIcon = document.getElementById('eyeIcon');

        const confirmPasswordPasswordInput = document.getElementById('confirmPasswordPasswordInput');
        const confirmPasswordToggleButton = document.getElementById('confirmPasswordTogglePassword');
        const confirmPasswordEyeIcon = document.getElementById('confirmPasswordEyeIcon');

        if (passwordInput && toggleButton && eyeIcon) {
            toggleButton.addEventListener('click', function () {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                eyeIcon.classList.toggle('text-gray-500', !isPassword);
                eyeIcon.classList.toggle('text-gray-800', isPassword);
            });
        }

        if (confirmPasswordPasswordInput && confirmPasswordToggleButton && confirmPasswordEyeIcon) {
            confirmPasswordToggleButton.addEventListener('click', function () {
                const isPassword = confirmPasswordPasswordInput.type === 'password';
                confirmPasswordPasswordInput.type = isPassword ? 'text' : 'password';
                confirmPasswordEyeIcon.classList.toggle('text-gray-500', !isPassword);
                confirmPasswordEyeIcon.classList.toggle('text-gray-800', isPassword);
            });
        }
    </script>
}