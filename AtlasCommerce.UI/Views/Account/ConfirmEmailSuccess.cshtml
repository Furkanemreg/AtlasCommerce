@model AtlasCommerce.Application.ViewModels.EmptyVM

@{
    ViewData["Title"] = "Email Doğrulandı";
    Layout = "_Layout";
}

<div style="max-width:520px;margin:80px auto;text-align:center;font-family:DM Sans, sans-serif;">

    <div style="width:80px;height:80px;border-radius:50%;background:#EAF3DE;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
        </svg>
    </div>

    <h2 style="font-weight:700;color:#1a1a1a;margin-bottom:10px;">
        Email başarıyla doğrulandı
    </h2>

    <p style="color:#666;font-size:14px;line-height:1.6;margin-bottom:25px;">
        Hesabınız aktifleştirildi. Artık giriş yapabilirsiniz.
    </p>

    <a href="/Account/Login"
       style="display:inline-block;padding:12px 22px;background:#1D9E75;color:#fff;border-radius:10px;text-decoration:none;font-weight:600;">
        Giriş Yap
    </a>

</div>