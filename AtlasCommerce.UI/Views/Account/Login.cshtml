@using AtlasCommerce.Application.ViewModels
@model LoginVM

@{
    var title = "User Login";
    if (!string.IsNullOrEmpty(Model?.Settings?.BrandName))
        title += $" - {Model.Settings.BrandName}";

    ViewData["Title"] = title;
    Layout = "_LoginLayout";

    var logoPath = Model?.Settings?.LogoPath;
}

<style>
    :root {
        --bg: #f3f4f6;
        --card: #ffffff;
        --text: #111827;
        --muted: #6b7280;
        --primary: #378ADD;
        --radius: 14px;
    }

    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        font-family: system-ui, sans-serif;
        padding: 24px;
    }

    .login-box {
        width: 100%;
        max-width: 420px;
    }

    .login-logo {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 24px;
    }

    .login-logo img {
        max-width: 180px;
        object-fit: contain;
    }

    .login-card {
        background: var(--card);
        border-radius: var(--radius);
        padding: 32px;
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
    }

    .title {
        text-align: center;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text);
    }

    .field {
        margin-bottom: 16px;
    }

    .label {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 6px;
        display: block;
    }

    .input {
        width: 100%;
        padding: 11px 12px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.1);
        outline: none;
        transition: .2s;
    }

    .input:focus {
        border-color: var(--primary);
    }

    .input-wrap {
        position: relative;
    }

    .eye-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
    }

    .remember {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
        font-size: 13px;
    }

    .switch {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn {
        width: 100%;
        margin-top: 18px;
        padding: 12px;
        border: none;
        border-radius: 10px;
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
    }

    .btn:hover {
        opacity: .9;
    }

    .error {
        font-size: 13px;
        color: #dc2626;
        margin-bottom: 10px;
    }
</style>

<div class="login-wrap">

    <div class="login-box">

        <div class="login-logo">
            <img src="@logoPath" />
        </div>

        <div class="login-card">

            <div class="title">Atlas Commerce</div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label class="label">Username</label>
                    <input asp-for="UserName"
                           name="Username"
                           class="input"
                           placeholder="Username"
                           autocomplete="off" />
                </div>

                <div class="field">
                    <label class="label">Password</label>

                    <div class="input-wrap">
                        <input id="passwordInput"
                               asp-for="Password"
                               type="password"
                               class="input"
                               placeholder="Password" />

                        <button type="button" id="togglePassword" class="eye-btn">
                            👁
                        </button>
                    </div>
                </div>

                <div class="remember">
                    <label class="switch">
                        <input asp-for="RememberMe" type="checkbox" />
                        Remember Me
                    </label>

                    <a href="#" style="color:var(--primary); text-decoration:none;">
                        Forgot Password
                    </a>
                </div>

                <div asp-validation-summary="All" class="error"></div>

                <button type="submit" class="btn">Sign In</button>

            </form>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("passwordInput");
        const btn = document.getElementById("togglePassword");

        btn.addEventListener("click", function () {
            input.type = input.type === "password" ? "text" : "password";
        });
    });
</script>

<script>
    $(document).ready(function () {
        var msg = '@TempData["RegisterMessage"]';
        if (msg) toastr.success(msg);

        var error = '@TempData["ErrorMessage"]';
        if (error) toastr.error(error);
    });
</script>