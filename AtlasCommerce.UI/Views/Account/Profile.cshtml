<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
<link href='https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap' rel='stylesheet'>

@using AtlasCommerce.Application.Interfaces
@inject ICurrentUserService _currentUserService
@model AtlasCommerce.Application.ViewModels.EmptyVM
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Account";
    var firstName = _currentUserService.FirstName();
    var lastName = _currentUserService.LastName();
    var userName = _currentUserService.UserName();
    var emailAddress = _currentUserService.EmailAddress();
    var phoneNumber = _currentUserService.PhoneNumber();
}

<style>
    :root {
        --ink: #0e0e11;
        --surface: #f5f4f0;
        --card: #ffffff;
        --accent: #337ab7;
        --accent-dark: #1d4466;
        --muted: #9a9a9a;
        --border: #e8e7e3;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 4px 24px rgba(0,0,0,0.08);
        --shadow-lg: 0 12px 48px rgba(0,0,0,0.12);
        --radius: 20px;
        --radius-sm: 12px;
    }

    .account-shell {
        min-height: 100vh;
        background: var(--surface);
        font-family: 'DM Sans', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
    }

    .account-card {
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        width: 100%;
        max-width: 420px;
        overflow: hidden;
        position: relative;
    }

    .account-card::before {
        content: '';
        display: block;
        height: 5px;
        background: linear-gradient(90deg, var(--ink) 0%, var(--accent) 100%);
    }

    .card-header {
        padding: 36px 36px 28px;
        border-bottom: 1px solid var(--border);
        position: relative;
    }

    .header-label {
        font-family: 'Syne', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 16px;
    }

    .avatar-row {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: relative;
    }

    .avatar-initials {
        font-family: 'Syne', sans-serif;
        font-size: 18px;
        font-weight: 800;
        color: var(--accent);
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .avatar-status {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        background: #4ade80;
        border-radius: 50%;
        border: 2px solid var(--card);
    }

    .avatar-info {
        min-width: 0;
    }

    .user-fullname {
        font-family: 'Syne', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.2;
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-handle {
        font-size: 13px;
        color: var(--muted);
        font-weight: 400;
        margin-top: 2px;
    }

    .card-info {
        padding: 24px 36px;
        border-bottom: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .info-icon {
        width: 34px;
        height: 34px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
        color: var(--ink);
    }

    .info-content {
        min-width: 0;
        flex: 1;
    }

    .info-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        line-height: 1;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-nav {
        padding: 20px 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .nav-btn {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: var(--ink);
        font-size: 14px;
        font-weight: 500;
        transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        position: relative;
        overflow: hidden;
    }

    .nav-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: var(--radius-sm);
        border: 1.5px solid transparent;
        transition: border-color 0.18s ease;
    }

    .nav-btn:hover {
        background: var(--surface);
        transform: translateX(3px);
    }

    .nav-btn:hover::after {
        border-color: var(--border);
    }

    .nav-btn.nav-settings {
        margin-top: 4px;
        background: var(--ink);
        color: #fff;
    }

    .nav-btn.nav-settings:hover {
        background: #1c1c22;
        transform: translateX(3px);
    }

    .nav-btn.nav-settings::after {
        display: none;
    }

    .nav-btn.nav-settings .nav-icon {
        background: rgba(255,255,255,0.1);
        color: var(--accent);
    }

    .nav-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
        transition: background 0.18s ease;
    }

    .nav-label {
        flex: 1;
    }

    .nav-arrow {
        font-size: 16px;
        color: var(--muted);
        transition: color 0.18s ease, transform 0.18s ease;
    }

    .nav-btn:hover .nav-arrow {
        color: var(--ink);
        transform: translateX(2px);
    }

    .nav-btn.nav-settings .nav-arrow {
        color: rgba(255,255,255,0.4);
    }

    .nav-btn.nav-settings:hover .nav-arrow {
        color: rgba(255,255,255,0.8);
    }

    .nav-badge {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: var(--accent);
        color: #fff;
        border-radius: 6px;
        padding: 2px 7px;
    }

    .account-card {
        animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
</style>

<div class="account-shell">
    <div class="account-card">

        <!-- Header -->
        <div class="card-header">
            <p class="header-label">Account</p>
            <div class="avatar-row">
                <div class="avatar">
                    <span class="avatar-initials">@(firstName?.Length > 0 ? firstName[0].ToString() : "")@(lastName?.Length > 0 ? lastName[0].ToString() : "")</span>
                    <span class="avatar-status"></span>
                </div>
                <div class="avatar-info">
                    <div class="user-fullname">@firstName @lastName</div>
                    <div class="user-handle">@@@userName</div>
                </div>
            </div>
        </div>

        <!-- Info Fields -->
        <div class="card-info">
            <div class="info-row">
                <div class="info-icon"><i class='bx bx-envelope'></i></div>
                <div class="info-content">
                    <div class="info-label">Email</div>
                    <div class="info-value">@emailAddress</div>
                </div>
            </div>
            <div class="info-row">
                <div class="info-icon"><i class='bx bx-phone'></i></div>
                <div class="info-content">
                    <div class="info-label">Phone</div>
                    <div class="info-value">@phoneNumber</div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="card-nav">
            <a asp-controller="Order" asp-action="Index" class="nav-btn">
                <div class="nav-icon"><i class='bx bx-shopping-bag'></i></div>
                <span class="nav-label">My Orders</span>
                <i class='bx bx-chevron-right nav-arrow'></i>
            </a>

            <a asp-controller="Payments" asp-action="Index" class="nav-btn">
                <div class="nav-icon"><i class='bx bx-credit-card'></i></div>
                <span class="nav-label">My Payments</span>
                <i class='bx bx-chevron-right nav-arrow'></i>
            </a>

            <a asp-action="Messages" class="nav-btn">
                <div class="nav-icon"><i class='bx bx-message-dots'></i></div>
                <span class="nav-label">My Messages</span>
                <span class="nav-badge">New</span>
                <i class='bx bx-chevron-right nav-arrow'></i>
            </a>

            <a asp-action="Settings" class="nav-btn nav-settings">
                <div class="nav-icon"><i class='bx bx-cog'></i></div>
                <span class="nav-label">Account Settings</span>
                <i class='bx bx-chevron-right nav-arrow'></i>
            </a>
        </div>

    </div>
</div>