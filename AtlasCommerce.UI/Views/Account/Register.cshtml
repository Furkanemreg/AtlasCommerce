@model AtlasCommerce.Application.ViewModels.RegisterVM
@{
    var logoPath = Model?.Settings?.LogoPath;

    var title = "Sign Up";
    if (!string.IsNullOrEmpty(Model?.Settings?.BrandName)) title += $" - {Model.Settings.BrandName}";
    ViewData["Title"] = title;

    Layout = "_RegisterLayout";
}

<div class="flex flex-col justify-center min-h-screen py-12 bg-gray-50 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="mt-6 flex justify-center">
            <img src="@logoPath" style="width: 200px;" />
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="px-4 py-8 bg-white shadow sm:rounded-lg sm:px-10">
            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 gap-6">

                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium theme-label">First Name *</label>
                        <input asp-for="FirstName" placeholder="First name"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium theme-label">Last Name *</label>
                        <input asp-for="LastName" placeholder="Last name"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="UserName" class="block text-sm font-medium theme-label">Username *</label>
                        <input asp-for="UserName" placeholder="Username"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium theme-label">Email Address *</label>
                        <input asp-for="Email" type="email" placeholder="example@mail.com"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="PhoneNumber" class="block text-sm font-medium theme-label">Phone *</label>
                        <input asp-for="PhoneNumber" placeholder="Phone number"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-medium theme-label">Password *</label>
                        <input asp-for="Password" type="password" placeholder="Password"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium theme-label">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm password"
                               class="theme-input block w-full rounded-md px-3 py-1.5 text-base sm:text-sm" />
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                    </div>

                </div>

                <div class="text-center my-3">
                    <div class="text-danger" asp-validation-summary="All"></div>
                </div>

                <div class="mt-6">
                    <span class="block w-full rounded-md shadow-sm">
                        <button type="submit"
                                class="primary-btn flex justify-center w-full px-4 py-2 text-sm font-medium border border-transparent rounded-md focus:outline-none transition duration-150 ease-in-out">
                            Sign Up
                        </button>
                    </span>
                </div>

                <div class="flex items-center justify-center mt-6">
                    <p class="text-sm text-gray-600">
                        Already have an account?
                        <a asp-action="Login" asp-controller="Account"
                           class="font-medium text-indigo-600 hover:text-indigo-500">
                            Sign In
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>