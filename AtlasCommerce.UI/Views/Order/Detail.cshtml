@using AtlasCommerce.UI.Helpers
@model AtlasCommerce.Application.ViewModels.OrderDetailVM

@{
    ViewData["Title"] = "Order Details";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
    .od-root {
        font-family: 'DM Sans', sans-serif;
        padding: 2rem 1rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .od-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 2rem;
    }

    .od-title-icon {
        width: 36px;
        height: 36px;
        background: #185FA5;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .od-title {
        font-family: 'Syne', sans-serif;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .od-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
    }

    .od-card-label {
        font-family: 'Syne', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        color: #aaa;
        margin-bottom: 1rem;
    }

    .od-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
    }

    .od-info-key {
        font-size: 11px;
        color: #aaa;
        margin-bottom: 3px;
    }

    .od-info-val {
        font-size: 13.5px;
        font-weight: 500;
        color: #1a1a1a;
    }

    .ol-ship {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #f5f5f5;
        color: #666;
    }

    .ol-pickup {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .span-pickup {
        color: #3B6D11;
    }

    .ol-delivery {
        background: #E9F2FF;
        color: #1D4ED8;
    }

    .span-delivery {
        color: #1D4ED8;
    }

    .status-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.2px;
    }

    .s-draft {
        background: #f0f0f0;
        color: #666;
    }

    .s-pending {
        background: #FAEEDA;
        color: #633806;
    }

    .s-paid {
        background: #E1F5EE;
        color: #085041;
    }

    .s-preparing {
        background: #EEEDFE;
        color: #3C3489;
    }

    .s-shipped {
        background: #E6F1FB;
        color: #0C447C;
    }

    .s-delivered {
        background: #EAF3DE;
        color: #27500A;
    }

    .s-cancelled {
        background: #FCEBEB;
        color: #791F1F;
    }

    .s-return {
        background: #FAECE7;
        color: #4A1B0C;
    }

    .s-returned {
        background: #D3D1C7;
        color: #2C2C2A;
    }

    .item-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .item-row:last-child {
        border-bottom: none;
    }

    .item-name {
        font-size: 13.5px;
        font-weight: 500;
        color: #1a1a1a;
        margin: 0;
    }

    .item-meta {
        font-size: 11px;
        color: #aaa;
        margin-top: 2px;
    }

    .item-unit {
        font-size: 13px;
        color: #888;
        text-align: right;
        white-space: nowrap;
    }

    .item-total {
        font-family: 'Syne', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: #1a1a1a;
        text-align: right;
        white-space: nowrap;
        min-width: 90px;
    }

    .pay-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        font-size: 13.5px;
        color: #666;
    }

    .summary-row .val {
        font-weight: 500;
        color: #1a1a1a;
        font-family: 'Syne', sans-serif;
    }

    .summary-row.grand {
        border-top: 1px solid #eee;
        margin-top: 8px;
        padding-top: 14px;
        font-weight: 500;
        color: #1a1a1a;
    }

    .summary-row.grand .val {
        font-size: 18px;
        font-weight: 700;
        color: #1D9E75;
    }

    .od-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
    }

    .od-actions form {
        margin: 0;
    }

    .od-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        box-sizing: border-box;
        border: 1px solid #e5e5e5;
        background: #fff;
        font-family: 'Syne', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        cursor: pointer;
    }

    .od-back {
        height: 32px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        box-sizing: border-box;
        font-family: 'Syne', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        color: #888;
        background: none;
        border: 1px solid #ddd;
        text-decoration: none;
        transition: all .2s;
        margin-left: auto;
    }

    .od-back:hover {
        background: #f5f5f5;
        color: #1a1a1a;
        border-color: #bbb;
    }

    .od-edit {
        color: #185FA5;
        border-color: rgba(24,95,165,.18);
        background: rgba(24,95,165,.05);
    }

    .od-edit:hover {
        background: rgba(24,95,165,.10);
        border-color: rgba(24,95,165,.28);
    }

    .od-delete {
        color: #B42318;
        border-color: rgba(180,35,24,.16);
        background: rgba(180,35,24,.05);
    }

    .od-delete:hover {
        background: rgba(180,35,24,.10);
        border-color: rgba(180,35,24,.28);
    }

    .od-success {
        color: #1D9E75;
        border-color: rgba(29, 158, 117, 0.22);
        background: rgba(29, 158, 117, 0.08);
    }

    .od-success:hover {
        background: rgba(29, 158, 117, 0.14);
        border-color: rgba(29, 158, 117, 0.35);
    }

    .del-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(2px);
    }

    .del-modal-backdrop.show {
        display: flex;
    }

    .del-modal {
        width: 100%;
        max-width: 380px;
        background: #fff;
        border-radius: 18px;
        padding: 28px 24px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
        animation: fadeIn .18s ease;
    }

    .del-modal-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #FDECEC;
        color: #D64545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
        margin: 0 auto 18px;
    }

    .del-modal-title {
        font-family: 'Syne',sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .del-modal-text {
        font-size: 14px;
        color: #777;
        margin-bottom: 24px;
    }

    .del-modal-actions {
        display: flex;
        gap: 10px;
    }

    .del-cancel-btn,
    .del-confirm-btn {
        flex: 1;
        height: 46px;
        border: none;
        border-radius: 12px;
        font-family: 'Syne',sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

    .del-cancel-btn {
        background: #f3f3f3;
        color: #555;
    }

    .del-cancel-btn:hover {
        background: #e7e7e7;
    }

    .del-confirm-btn {
        background: #D64545;
        color: #fff;
    }

    .del-confirm-btn:hover {
        background: #BB3535;
    }

    .od-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 8px 0;
        border-bottom: 1px solid #f2f2f2;
        gap: 20px;
    }

    .od-row:last-child {
        border-bottom: none;
    }

    .od-key {
        font-size: 12px;
        color: #999;
        min-width: 120px;
    }

    .od-value {
        font-size: 13px;
        color: #1a1a1a;
        font-weight: 500;
        text-align: right;
    }

    .od-row.full {
        flex-direction: column;
        align-items: flex-start;
    }

    .od-row.full .od-value {
        text-align: left;
        margin-top: 6px;
        font-weight: 400;
        line-height: 1.6;
    }

    .flex-center {
        display: flex;
        align-items: center;
    }

    .ml-2 {
        margin-left: 6px;
    }
</style>

<div class="od-root">
    <div class="od-header">
        <div class="od-title-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                <rect x="9" y="3" width="6" height="4" rx="2" />
                <path d="M9 12h6M9 16h4" />
            </svg>
        </div>

        <h1 class="od-title mt-3">Order Details</h1>

        <div class="od-actions">
            @if (Model.Status == enmOrderStatus.Draft || Model.Status == enmOrderStatus.PendingPayment)
            {
                @* 
                <a href="/Order/Edit/@Model.Id"
                   class="od-btn od-edit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.3"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                    </svg>
                    Düzenle
                </a> *@

                <form asp-controller="Order" asp-action="StartPayment" method="post" style="display:inline; margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <button type="submit" class="od-btn od-success">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.3"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="5" width="20" height="14" rx="2" ry="2" />
                            <line x1="2" y1="10" x2="22" y2="10" />
                        </svg>
                        Pay
                    </button>
                </form>

                <button type="button"
                        onclick="openDeleteModal()"
                        class="od-btn od-delete">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.3"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14H6L5 6" />
                        <path d="M10 11v6" />
                        <path d="M14 11v6" />
                        <path d="M9 6V4h6v2" />
                    </svg>
                    Delete
                </button>
            }

            <a asp-controller="Order" asp-action="Index" class="od-back">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                Return to My Orders
            </a>
        </div>
    </div>

    <!-- Sipariş Bilgileri -->
    <div class="od-card">
        <div class="od-card-label">Delivery Method</div>
        <div class="od-info-grid">
            <div>
                @if (Model.IsPickup)
                {
                    <span class="ol-ship ol-pickup">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18" />
                            <path d="M5 21V7l7-4 7 4v14" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>

                    <span class="ms-2 span-pickup">In-Store Pickup</span>
                }
                else
                {
                    <span class="ol-ship ol-delivery">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3h13v13H3z" />
                            <path d="M16 8h4l1 3v5h-5z" />
                            <circle cx="7.5" cy="18.5" r="1.5" />
                            <circle cx="17.5" cy="18.5" r="1.5" />
                        </svg>
                    </span>

                    <span class="ms-2 span-delivery">Home Delivery</span>
                }
            </div>
        </div>
    </div>

    <div class="od-card">
        <div class="od-card-label">Order Informations</div>
        <div class="od-info-grid">
            <div>
                <div class="od-info-key">Order Number</div>
                <div class="od-info-val" style="font-family:'Syne',sans-serif;">#@Model.OrderNumber</div>
            </div>
            <div>
                <div class="od-info-key">Order Date</div>
                <div class="od-info-val">@Model.CreatedAt.ToString("dd.MM.yyyy") — @Model.CreatedAt.ToString("HH:mm")</div>
            </div>
            <div>
                <div class="od-info-key">Status</div>
                @{
                    var statusClass = Model.Status switch
                    {
                        enmOrderStatus.Draft => "s-draft",
                        enmOrderStatus.PendingPayment => "s-pending",
                        enmOrderStatus.Paid => "s-paid",
                        enmOrderStatus.Preparing => "s-preparing",
                        enmOrderStatus.Shipped => "s-shipped",
                        enmOrderStatus.Delivered => "s-delivered",
                        enmOrderStatus.Cancelled => "s-cancelled",
                        enmOrderStatus.ReturnRequested => "s-return",
                        enmOrderStatus.Returned => "s-returned",
                        _ => "s-draft"
                    };
                }
                <span class="status-badge @statusClass">
                    @EnumHelper.GetEnumDescription(Model.Status)
                </span>
            </div>
        </div>
    </div>

    <!-- Ürünler -->
    <div class="od-card">
        <div class="od-card-label">Products</div>
        @foreach (var item in Model.Items)
        {
            <div class="item-row">
                <div>
                    <p class="item-name">@item.ProductName</p>
                    <p class="item-meta">Product Code: @item.Barcode</p>
                </div>
                <div class="item-unit">@item.Quantity pcs × ₺ @item.UnitPrice.ToString("N2")</div>
                <div class="item-total">₺ @item.TotalPrice.ToString("N2")</div>
            </div>
        }
    </div>

    <!-- Ödeme Bilgileri -->
    @if (Model.Payment != null)
    {
        <div class="od-card">
            <div class="od-card-label">Payment Details</div>
            <div class="pay-grid">
                <div>
                    <div class="od-info-key">Amount</div>
                    <div class="od-info-val">₺ @Model.Payment.Amount.ToString("N2")</div>
                </div>
                <div>
                    <div class="od-info-key">Status</div>
                    <div class="od-info-val">@EnumHelper.GetEnumDescription(Model.Payment.Status)</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Payment.CardBrand))
                {
                    <div>
                        <div class="od-info-key">Card</div>
                        <div class="od-info-val">@Model.Payment.CardBrand (@Model.Payment.CardNumber)</div>
                    </div>
                }
                <div>
                    <div class="od-info-key">Created Date</div>
                    <div class="od-info-val">
                        @Model.Payment.CreatedAt.ToString("dd.MM.yyyy") - <span class="text-muted">@Model.Payment.CreatedAt.ToString("HH:mm")</span>
                    </div>
                </div>
                @if (Model.Payment.PaidAt.HasValue && Model.Payment.PaidAt != DateTime.MinValue)
                {
                    <div>
                        <div class="od-info-key">Payment Date</div>
                        <div class="od-info-val">
                            @Model.Payment.PaidAt.Value.ToString("dd.MM.yyyy") - <span class="text-muted">@Model.Payment.PaidAt.Value.ToString("HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    
    <!-- Adres Bilgileri -->
    <div class="od-card">
        <div class="od-card-label">Delivery Informations</div>

        <div class="od-row">
            <span class="od-key">Delivery Method</span>

            <div class="od-value flex-center">
                @if (Model.IsPickup)
                {
                    <span class="ol-ship ol-pickup">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18" />
                            <path d="M5 21V7l7-4 7 4v14" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <span class="ml-2 span-pickup">In-Store Pickup</span>
                }
                else
                {
                    <span class="ol-ship ol-delivery">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3h13v13H3z" />
                            <path d="M16 8h4l1 3v5h-5z" />
                            <circle cx="7.5" cy="18.5" r="1.5" />
                            <circle cx="17.5" cy="18.5" r="1.5" />
                        </svg>
                    </span>
                    <span class="ml-2 span-delivery">Home Delivery</span>
                }
            </div>
        </div>
        
        <div class="od-row">
            <span class="od-key">Country</span>
            <span class="od-value">@Model.Country</span>
        </div>

        <div class="od-row">
            <span class="od-key">City</span>
            <span class="od-value">@Model.City</span>
        </div>

        <div class="od-row">
            <span class="od-key">District</span>
            <span class="od-value">@Model.District</span>
        </div>

        <div class="od-row">
            <span class="od-key">Postal Code</span>
            <span class="od-value">@Model.ZipCode</span>
        </div>

        <div class="od-row full">
            <span class="od-key">Full Address</span>
            <span class="od-value">@Model.Address</span>
        </div>
    </div>

    <!-- Sipariş Özeti -->
    <div class="od-card">
        <div class="od-card-label">Sipariş Özeti</div>
        <div class="summary-row">
            <span>Subtotal</span>
            <span class="val">₺ @Model.SubTotal.ToString("N2")</span>
        </div>
        @if (Model.TotalTAX > 0)
        {
            <div class="summary-row">
                <span>Taxes</span>
                <span class="val">₺ @Model.TotalTAX.ToString("N2")</span>
            </div>
        }
        <div class="summary-row grand">
            <span>Grand Total</span>
            <span class="val">₺ @Model.TotalAmount.ToString("N2")</span>
        </div>
    </div>

</div>

<div class="del-modal-backdrop" id="deleteModalBackdrop">
    <div class="del-modal">
        <div class="del-modal-icon">
            !
        </div>

        <div class="del-modal-title">
            Are you sure you want to delete this order?
        </div>

        <div class="del-modal-text">
            This action cannot be undone.
        </div>

        <div class="del-modal-actions">
            <button type="button"
                    class="del-cancel-btn"
                    onclick="closeDeleteModal()">
                Cancel
            </button>

            <button type="button"
                    class="del-confirm-btn"
                    onclick="confirmDelete()">
                Delete
            </button>
        </div>
    </div>
</div>

<script>
    function openDeleteModal() {

        document
            .getElementById("deleteModalBackdrop")
            .classList.add("show");

        document.body.style.overflow = "hidden";
    }

    function closeDeleteModal() {

        document
            .getElementById("deleteModalBackdrop")
            .classList.remove("show");

        document.body.style.overflow = "";
    }

    async function confirmDelete() {

        try {

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Order/DeleteDraft?orderId=@Model.Id', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            });

            if (response.ok) {
                toastr.success(response.message || 'Your order has been deleted.');
                setTimeout(function () {
                    window.location.href = '/Order/Index';
                }, 3000);

                return;
            }

            const errorText = await response.text();

            toastr.error(errorText || 'An error occurred while deleting the order.');

        } catch {
            toastr.error('An error occurred while deleting the order.');
        }
    }

    document.addEventListener("keydown", function (e) {

        if (e.key === "Escape")
            closeDeleteModal();
    });
</script>