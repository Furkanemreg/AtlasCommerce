@using AtlasCommerce.Application.ViewModels
@model List<DropdownCategoryVM>

<!-- Masaüstü kategoriler -->
<div class="nav-categories" id="desktopCategoryMenu">
    <div class="category-wrapper container">
        @foreach (var category in Model)
        {
            <a asp-controller="Categories"
               asp-action="View"
               asp-route-id="@category.Id"
               class="category-link"
               data-target="dropdown-@category.Id">
                @category.Name
            </a>
        }

    </div>
</div>

