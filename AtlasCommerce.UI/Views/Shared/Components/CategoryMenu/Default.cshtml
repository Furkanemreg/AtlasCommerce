<!-- Mobil kategoriler -->
<div class="category-dropdown d-none" id="categoryDropdown">
    <ul class="category-menu">
        @foreach (var category in (List<CategoryWithProductsVM>)ViewBag.CategoryWithProducts)
        {
            <li class="category-menu-item-wrapper">
                <div class="category-menu-item">
                    <a class="mobile-category-link-text" asp-controller="Categories"
                       asp-action="View"
                       asp-route-id="@category.Id">
                        <span>@category.Name</span>
                    </a>
                    @if (category.Products != null && category.Products.Any())
                    {
                        <span class="submenu-toggle">
                            <i class="ri-arrow-right-s-line"></i>
                        </span>
                    }
                </div>
                <ul class="submenu">
                    @if (category.Products != null && category.Products.Any())
                    {
                        foreach (var product in category.Products)
                        {
                            <li>
                                <a asp-controller="Products" asp-action="View" asp-route-id="@product.Id" style="text-decoration: none;">
                                    @product.Title
                                </a>
                            </li>
                        }
                    }
                </ul>
            </li>
        }

    </ul>
</div>


