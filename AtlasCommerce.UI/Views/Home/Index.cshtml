                        <!-- Başlık ve Tümünü Görüntüle -->
                        <div class="showcase-header">
                            <h3 class="showcase-category-title">@category.Name</h3>
                    <a asp-controller="Categories" asp-action="View" asp-route-id="@category.Id" class="view-all-btn-topright">Tümünü Görüntüle</a>
                        </div>

                        <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
