@using AtlasCommerce.Application.ViewModels
@model PageVM

@{
    ViewData["Title"] = Model?.Settings?.BrandName;
}

<style>
    /* ── HERO ─────────────────────────────── */
    .hero {
        position: relative;
        width: 100%;
        height: 90vh;
        min-height: 580px;
        overflow: hidden;
        background: var(--navy);
    }

    /* Slides */
    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 1s ease;
    }

    .hero-slide.active {
        opacity: 1;
    }

    .hero-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.3;
        transform: scale(1.04);
        transition: transform 9s ease;
        display: block;
    }

    .hero-slide.active img {
        transform: scale(1);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(17,24,39,0.92) 0%, rgba(17,24,39,0.55) 50%, rgba(17,24,39,0.15) 100% );
        z-index: 1;
    }

    /* Content */
    .hero-body {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 8vw;
        max-width: 680px;
    }

    .hero-eyebrow {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 20px;
        animation: up 0.7s 0.1s both;
    }

    .hero-title {
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.8rem, 5.5vw, 5rem);
        font-weight: 400;
        line-height: 1.05;
        color: rgba(255,255,255,0.55);
        margin-bottom: 20px;
        animation: up 0.7s 0.25s both;
    }

    .hero-title em {
        font-style: italic;
        color: rgba(255,255,255,0.55);
    }

    .hero-sub {
        font-size: 15px;
        font-weight: 300;
        color: rgba(255,255,255,0.45);
        line-height: 1.7;
        max-width: 380px;
        margin-bottom: 40px;
        animation: up 0.7s 0.38s both;
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 30px;
        background: var(--white);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: background 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
        animation: up 0.7s 0.5s both;
        width: fit-content;
    }

    .hero-cta:hover {
        background: var(--accent);
        color: #3264a8;
        transform: translateX(4px);
    }

    /* Nav */
    .hero-nav {
        position: absolute;
        bottom: 36px;
        right: 5vw;
        z-index: 3;
        display: flex;
        gap: 8px;
    }

    .hero-btn {
        width: 44px;
        height: 44px;
        border: 1px solid rgba(255,255,255,0.18);
        background: transparent;
        color: rgba(255,255,255,0.6);
        font-size: 17px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .hero-btn:hover {
        background: var(--white);
        color: var(--navy);
        border-color: var(--white);
    }

    /* Counter */
    .hero-count {
        position: absolute;
        bottom: 48px;
        left: 8vw;
        z-index: 3;
        font-size: 12px;
        color: rgba(255,255,255,0.3);
        letter-spacing: 0.1em;
    }

    .hero-count strong {
        color: rgba(255,255,255,0.75);
        font-size: 18px;
        font-weight: 300;
    }
</style>

@* ─── HERO ──────────────────────────────────── *@
@if (Model?.Banners != null && Model.Banners.Any())
{
    <div class="hero" id="heroEl">
        @{
            int bi = 0;
        }
        @foreach (var banner in Model.Banners)
        {
            <div class="hero-slide @(bi == 0 ? "active" : "")" data-i="@bi">
                <img src="@Url.Content(string.IsNullOrEmpty(banner.ImagePath) ? "~/img/placeholder.jpg" : banner.ImagePath)"
                     alt="@banner.Title" />
            </div>
            bi++;
        }

        <div class="hero-overlay"></div>

        <div class="hero-body">
            <div class="hero-eyebrow">Istanbul Atlas University</div>
            <h1 class="hero-title">Atlas <em>Commerce</em></h1>
            <p class="hero-sub">Official digital commerce platform of Istanbul Atlas University.</p>
            <a asp-controller="Products" asp-action="All" class="hero-cta">Shop Now &rarr;</a>
        </div>

        <div class="hero-count">
            <strong id="hCur">01</strong> / @Model.Banners.Count.ToString("D2")
        </div>

        <div class="hero-nav">
            <button class="hero-btn" id="hPrev">&#8592;</button>
            <button class="hero-btn" id="hNext">&#8594;</button>
        </div>
    </div>

    <script>
        (function () {
            var slides = document.querySelectorAll('#heroEl .hero-slide');
            var cur = document.getElementById('hCur');
            var n = slides.length, i = 0, t;
            function go(x) {
                slides[i].classList.remove('active');
                i = (x + n) % n;
                slides[i].classList.add('active');
                cur.textContent = String(i + 1).padStart(2, '0');
            }
            function reset() { clearInterval(t); t = setInterval(function () { go(i + 1); }, 5500); }
            document.getElementById('hNext').onclick = function () { go(i + 1); reset(); };
            document.getElementById('hPrev').onclick = function () { go(i - 1); reset(); };
            reset();
        })();
    </script>
}

@if (Model?.RecommendedProducts != null && Model.RecommendedProducts.Any())
{
    <section class="home-products recommended-section">
        <div class="relative w-full mb-6">

            <!-- BAŞLIK (tam ortada) -->
            <h2 class="text-center products-title bg-gradient-to-r from-emerald-600 via-sky-500 to-emerald-500 bg-clip-text text-transparent">
                Recommended For You
            </h2>
            
            <!-- TOOLTIP (EN SAĞ ÜST) -->
            <div class="absolute top-0 right-0 group">
                <span class="w-7 h-7 flex items-center justify-center rounded-full bg-gray-600 text-white text-sm cursor-pointer select-none leading-none hover:bg-gray-700 transition shadow-sm">
                    ❔
                </span>

                <!-- TOOLTIP -->
                <div class="absolute right-0 top-6 w-72 p-3 text-xs bg-white border rounded-lg shadow-lg hidden group-hover:block z-[9999]">
                    <b>These products are recommended based on the following criteria:</b>

                    <ul class="mt-2 list-disc pl-4">
                        <li>Product categories you have purchased</li>
                        <li>Similar price range</li>
                        <li>Discounted items priority</li>
                        <li>Stock availability and popularity</li>
                    </ul>
                </div>

            </div>

        </div>

        @{
            var groupedRecommended = Model.RecommendedProducts
            .Select((p, i) => new { p, i })
            .GroupBy(x => x.i / 4)
            .ToList();

            var recommendedCarouselId = "recommendedProductsCarousel";
            var recommendedSlideIndex = 0;
        }

        <div id="@recommendedCarouselId" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">

                @foreach (var slide in groupedRecommended)
                {
                    <div class="carousel-item @(recommendedSlideIndex == 0 ? "active" : "")">
                        <div class="products-wrapper">

                            @foreach (var item in slide)
                            {
                                <a asp-controller="Products" asp-action="View" asp-route-id="@item.p.Id"
                                   style="text-decoration:none;">

                                    <div class="product-box relative group hover:shadow-xl transition-all duration-300">

                                        <!-- AI Badge -->
                                        <div class="absolute top-2 left-2 bg-gradient-to-r from-purple-500 to-indigo-500 text-white text-xs px-2 py-1 rounded-full">
                                            Smart Pick
                                        </div>

                                        <!-- Image -->
                                        @if (item.p.Images != null && item.p.Images.Any())
                                        {
                                            <img class="rounded-lg"
                                                 src="@item.p.Images.First().DataUri"
                                                 alt="@item.p.Title" />
                                        }
                                        else
                                        {
                                            <img class="rounded-lg" src="/img/placeholder.jpg" />
                                        }

                                        <!-- Title -->
                                        <h4 class="mt-2 font-semibold">@item.p.Title</h4>

                                        <!-- Price -->
                                        <div class="text-indigo-600 font-bold min-h-[3.5rem] text-center">

                                            @if (item.p.DiscountRate > 0
                                           && item.p.DiscountStartAt.HasValue
                                           && item.p.DiscountEndAt.HasValue
                                           && DateTime.Now.Date >= item.p.DiscountStartAt.Value.Date
                                           && DateTime.Now.Date <= item.p.DiscountEndAt.Value.Date)
                                            {
                                                @(item.p.SalePriceWithDiscount.ToString("N2") + "₺")
                                                <br />
                                                <span class="line-through text-gray-400 text-sm">
                                                    @item.p.SalePrice.ToString("N2") ₺
                                                </span>
                                            }
                                            else
                                            {
                                                @(item.p.SalePrice.ToString("N2") + "₺")
                                            }

                                        </div>

                                    </div>
                                </a>
                            }

                        </div>
                    </div>

                    recommendedSlideIndex++;
                }

            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#@recommendedCarouselId" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#@recommendedCarouselId" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

    </section>
}
<!-- Seçili Ürünler bölümü -->
@if (Model?.SelectedProducts != null && Model.SelectedProducts.Any())
{
        <section class="home-products">
        <h2 class="products-title">Featured Products</h2>

        @{
            var groupedSelected = Model.SelectedProducts
                .Select((p, i) => new { p, i })
                .GroupBy(x => x.i / 4)
                .ToList();

            var selectedCarouselId = "selectedProductsCarousel";
            var selectedSlideIndex = 0;
        }

            <div id="@selectedCarouselId" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                @foreach (var slide in groupedSelected)
                {
                            <div class="carousel-item @(selectedSlideIndex == 0 ? "active" : "")">
                                <div class="products-wrapper">
                            @foreach (var item in slide)
                            {
                                            <a asp-controller="Products" asp-action="View" asp-route-id="@item.p.Id" style="text-decoration: none;">
                                                <div class="product-box">
                                                @if (item.p.Images != null && item.p.Images.Any())
                                                {
                                                    <img src="@item.p.Images.First().DataUri" alt="@item.p.Title" />
                                                }
                                                else
                                                {
                                                    <img src="/img/placeholder.jpg" alt="@item.p.Title" />
                                                }

                                          <h4>@item.p.Title</h4>

                                          <div class="text-blue-400 font-semibold min-h-[3.5rem] text-center">
                                          @if (item.p.DiscountRate > 0
                                                && item.p.DiscountStartAt.HasValue
                                                && item.p.DiscountEndAt.HasValue
                                                && DateTime.Now.Date >= item.p.DiscountStartAt.Value.Date
                                                && DateTime.Now.Date <= item.p.DiscountEndAt.Value.Date)
                                            {
                                                @(item.p.SalePriceWithDiscount.ToString("N2") + "₺") <br />
                                                                <span class="line-through text-gray-400 text-sm ml-1">@item.p.SalePrice.ToString("N2") ₺</span>
                                            }
                                            else if (item.p.SalePrice > 0)
                                            {
                                                @(item.p.SalePrice.ToString("N2") + "₺")
                                            }
                                            else
                                            {
                                                <span>&nbsp;</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            }
                                </div>
                            </div>
                    selectedSlideIndex++;
                }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#@selectedCarouselId" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#@selectedCarouselId" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

            <div class="products-footer mt-4">
            <a asp-controller="Products" asp-action="All" class="view-all-btn">View All Products</a>
            </div>
        </section>
}


<!-- Body => Kategoriler Alanı -->
<section class="home-categories">
    <h2 class="categories-title">Featured Categories</h2>

    <div class="categories-wrapper">
        @foreach (var category in Model.DropdownCategories ?? Enumerable.Empty<DropdownCategoryVM>())
        {
                <a style="text-decoration: none;" class="a-category-box"
                   asp-controller="Categories" asp-action="View" asp-route-id="@category.Id">
                    <div class="category-box">
                    @if (!string.IsNullOrEmpty(category.ImageDataUri))
                    {
                                <img src="@category.ImageDataUri" class="card-img-top" alt="@category.Name" style="height:200px; object-fit:cover;">
                    }
                    else
                    {
                                <img src="~/img/placeholder.jpg" class="card-img-top" alt="@category.Name" style="height:200px; object-fit:cover;">
                    }
                        <h3>@category.Name</h3>
                    </div>
                </a>
        }
    </div>

    <div class="categories-footer">
        <a asp-controller="Categories" asp-action="Index" class="view-all-btn">View All Categories</a>
    </div>
</section>

