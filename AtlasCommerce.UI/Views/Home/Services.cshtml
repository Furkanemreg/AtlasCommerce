@model AtlasCommerce.Application.ViewModels.ServicePageVM

@{
    ViewData["Title"] = "Services";
}
<style>
    .montaj-card {
        min-height: 700px;
    }
</style>
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-3xl">OUR SERVICES</h1>
            <p class="text-muted">Professional solutions provided by @Model?.Settings?.BrandName</p>
        </div>

        <div class="row g-4 justify-content-center">
            @if (Model != null && Model?.Items != null && Model?.Items?.Count > 0)
            {
                @foreach (var service in Model.Items)
                {
                    <div class="col-md-6 col-lg-5">
                        <div class="bg-white rounded shadow-sm h-100 overflow-hidden d-flex flex-column">
                            <img src="@Url.Content(string.IsNullOrEmpty(service.ImagePath) ? "~/images/no-image.png" : service.ImagePath)"
                                 alt="@service.Title"
                                 class="img-fluid w-100"
                                 style="height:300px; object-fit:cover;" />
                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <h5 class="fw-bold mb-2">@service.Title</h5>
                                <p>@service.Text</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
