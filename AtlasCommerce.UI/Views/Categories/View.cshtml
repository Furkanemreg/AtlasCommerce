@using AtlasCommerce.Application.ViewModels
@model CategoryPageVM

@{
    Layout = "_Layout";
    ViewData["Title"] = Model?.Category?.Name;

    var settings = Model?.Settings as WebsiteSettingsVM;

    string phoneNumber = "";
    string emailAddress = "";

    if (settings != null)
    {
        phoneNumber = !string.IsNullOrWhiteSpace(settings!.PhoneNumber) ? settings!.PhoneNumber.Replace(" ", "") : "";
        emailAddress = !string.IsNullOrWhiteSpace(settings!.EmailAddress) ? settings!.EmailAddress.Replace(" ", "") : "";
    }

    // var searchTerm = Model.SearchTerm ?? "";
    var pageSize = Model.PageSize;
    var currentPage = Model.PageNumber;
    var totalPages = Model.TotalPages;
    int groupSize = 4;
    int currentGroup = (currentPage - 1) / groupSize;
    int startPage = currentGroup * groupSize + 1;
    int endPage = Math.Min(startPage + groupSize - 1, totalPages);
}

<div class="bg-white">
    <div>
        <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex items-baseline justify-between border-b border-gray-200 pt-24 pb-6">
                <h1 class="text-4xl font-bold tracking-tight text-gray-900">@Model?.Category?.Name</h1>

                <div class="flex items-center">
                    <div class="relative inline-block text-left">
                        <div>
                            <button id="menu-button" type="button" aria-expanded="false" aria-haspopup="true" class="group inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900">
                                Sorting
                                <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="-mr-1 ml-1 size-5 shrink-0 text-gray-400 group-hover:text-gray-500">
                                    <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
                                </svg>
                            </button>
                        </div>

                        <div role="menu" id="sortingDiv" tabindex="-1" aria-labelledby="menu-button" aria-orientation="vertical" class="absolute right-0 z-10 mt-2 w-40 origin-top-right rounded-md bg-white shadow-2xl ring-1 ring-black/5 focus:outline-hidden">
                            <div role="none" class="py-1">
                                <a id="menu-item-0"
                                   role="menuitem"
                                   class="block px-4 py-2 text-sm text-gray-500" 
                                   href="@Url.Action("View", new { id = Model.Category.Id, sort = "newest",
                                            minPrice = Model.Filter?.MinPrice, maxPrice = Model.Filter?.MaxPrice,
                                            minWidth = Model.Filter?.MinWidth, maxWidth = Model.Filter?.MaxWidth, 
                                            minHeight = Model.Filter?.MinHeight, maxHeight = Model.Filter?.MaxHeight, 
                                            minWeight = Model.Filter?.MinWeight, maxWeight = Model.Filter?.MaxWeight, 
                                            mixLength = Model.Filter?.MinLength, maxLength = Model.Filter?.MaxLength,
                                            SelectedColors = Model.Filter?.SelectedColors
                                        })">
                                    Newest
                                </a>
                                <a id="menu-item-1"
                                   role="menuitem"
                                   class="block px-4 py-2 text-sm text-gray-500"
                                   href="@Url.Action("View", new { id = Model.Category.Id, sort = "priceasc",
                                            minPrice = Model.Filter?.MinPrice, maxPrice = Model.Filter?.MaxPrice,
                                            minWidth = Model.Filter?.MinWidth, maxWidth = Model.Filter?.MaxWidth,
                                            minHeight = Model.Filter?.MinHeight, maxHeight = Model.Filter?.MaxHeight,
                                            minWeight = Model.Filter?.MinWeight, maxWeight = Model.Filter?.MaxWeight,
                                            mixLength = Model.Filter?.MinLength, maxLength = Model.Filter?.MaxLength,
                                            SelectedColors = Model.Filter?.SelectedColors
                                        })">Price: Low to High</a>

                                <a id="menu-item-2"
                                   role="menuitem"
                                   class="block px-4 py-2 text-sm text-gray-500"
                                   href="@Url.Action("View", new { id = Model.Category.Id, sort = "pricedesc",
                                            minPrice = Model.Filter?.MinPrice, maxPrice = Model.Filter?.MaxPrice,
                                            minWidth = Model.Filter?.MinWidth, maxWidth = Model.Filter?.MaxWidth,
                                            minHeight = Model.Filter?.MinHeight, maxHeight = Model.Filter?.MaxHeight,
                                            minWeight = Model.Filter?.MinWeight, maxWeight = Model.Filter?.MaxWeight,
                                            mixLength = Model.Filter?.MinLength, maxLength = Model.Filter?.MaxLength,
                                            SelectedColors = Model.Filter?.SelectedColors
                                        })">Price: High to Low</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <section aria-labelledby="products-heading" class="pt-6 pb-24">
                <h2 id="products-heading" class="sr-only">Products</h2>

                <div class="grid grid-cols-1 gap-x-8 gap-y-10 lg:grid-cols-4">
                    <form class="block" method="get">
                        <!-- kategori id’sini de querystring’e eklemek için hidden -->
                        <input type="hidden" name="id" value="@Model?.Category?.Id" />

                        <h3 class="sr-only">Categories</h3>

                        <!-- SIDE FILTERS -->

                        <!-- PRICE -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="price-filter-toggle" type="button"
                                        aria-controls="price-filter-section-price"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Fiyat Aralığı (₺)</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="price-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="price-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <div id="price-filter-section-price" class="pt-6 space-y-4">

                                <!-- Min / Max input alanları -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col">
                                        <input id="min-price" name="minPrice" value="@Model?.Filter?.MinPrice" type="number" value="" min="0" max="999999" placeholder="0 ₺"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                    <span class="text-gray-500">–</span>
                                    <div class="flex flex-col">
                                        <input id="max-price" type="number" value="@Model?.Filter?.MaxPrice" name="maxPrice" value="" min="0" max="999999" placeholder="999.999 ₺"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                </div>

                                <!-- Tek bar, iki handle -->
                                <div class="relative h-8 flex items-center">
                                    <!-- arka bar -->
                                    <div class="absolute h-1 w-full bg-gray-200 rounded"></div>
                                    <!-- seçili aralık -->
                                    <div id="range-track" class="absolute h-1 rounded" style="background-color: #dc3545;"></div>

                                    <!-- Min handle -->
                                    <input id="range-min" type="range" min="0" max="999999" step="1" value="0" class="slider-thumb">
                                    <input id="range-max" type="range" min="0" max="999999" step="1" value="999999" class="slider-thumb">
                                </div>
                            </div>
                        </div>

                        <!-- WIDTH -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="width-filter-toggle" type="button"
                                        aria-controls="width-filter-section-width"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Width (cm)</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="width-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="width-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <div id="width-filter-section-width" class="pt-6 space-y-4">

                                <!-- Min / Max input alanları -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col">
                                        <input id="min-width" name="minWidth" value="@Model?.Filter?.MinWidth" type="number" value="" min="0" max="10000" placeholder="0 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                    <span class="text-gray-500">–</span>
                                    <div class="flex flex-col">
                                        <input id="max-width" name="maxWidth" value="@Model?.Filter?.MaxWidth" type="number" value="" min="0" max="10000" placeholder="10000 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                </div>

                                <!-- Tek bar, iki handle -->
                                <div class="relative h-8 flex items-center">
                                    <!-- arka bar -->
                                    <div class="absolute h-1 w-full bg-gray-200 rounded"></div>
                                    <!-- seçili aralık -->
                                    <div id="range-track-width" class="absolute h-1 rounded" style="background-color: #dc3545;"></div>

                                    <!-- Min handle -->
                                    <input id="range-min-width" type="range" min="0" max="10000" step="1" value="0" class="slider-thumb">
                                    <input id="range-max-width" type="range" min="0" max="10000" step="1" value="10000" class="slider-thumb">
                                </div>
                            </div>
                        </div>

                        <!-- HEIGHT -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="height-filter-toggle" type="button"
                                        aria-controls="height-filter-section-height"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Height (cm)</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="height-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="height-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <div id="height-filter-section-height" class="pt-6 space-y-4">

                                <!-- Min / Max input alanları -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col">
                                        <input id="min-height" name="minHeight" value="@Model?.Filter?.MinHeight" type="number" value="" min="0" max="10000" placeholder="0 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                    <span class="text-gray-500">–</span>
                                    <div class="flex flex-col">
                                        <input id="max-height" name="maxHeight" value="@Model?.Filter?.MaxHeight" type="number" value="" min="0" max="10000" placeholder="10000 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                </div>

                                <!-- Tek bar, iki handle -->
                                <div class="relative h-8 flex items-center">
                                    <!-- arka bar -->
                                    <div class="absolute h-1 w-full bg-gray-200 rounded"></div>
                                    <!-- seçili aralık -->
                                    <div id="range-track-height" class="absolute h-1 rounded" style="background-color: #dc3545;"></div>

                                    <!-- Min handle -->
                                    <input id="range-min-height" type="range" min="0" max="10000" step="1" value="0" class="slider-thumb">
                                    <input id="range-max-height" type="range" min="0" max="10000" step="1" value="10000" class="slider-thumb">
                                </div>
                            </div>
                        </div>

                        <!-- WEIGHT -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="weight-filter-toggle" type="button"
                                        aria-controls="weight-filter-section-weight"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Weight (kg)</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="weight-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="weight-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <div id="weight-filter-section-weight" class="pt-6 space-y-4">

                                <!-- Min / Max input alanları -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col">
                                        <input id="min-weight" name="minWeight" value="@Model?.Filter?.MinWeight" type="number" value="" min="0" max="10000" placeholder="0 kg"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                    <span class="text-gray-500">–</span>
                                    <div class="flex flex-col">
                                        <input id="max-weight" name="maxWeight" value="@Model?.Filter?.MaxWeight" type="number" value="" min="0" max="10000" placeholder="10000 kg"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                </div>

                                <!-- Tek bar, iki handle -->
                                <div class="relative h-8 flex items-center">
                                    <!-- arka bar -->
                                    <div class="absolute h-1 w-full bg-gray-200 rounded"></div>
                                    <!-- seçili aralık -->
                                    <div id="range-track-weight" class="absolute h-1 rounded" style="background-color: #dc3545;"></div>

                                    <!-- Min handle -->
                                    <input id="range-min-weight" type="range" min="0" max="10000" step="1" value="0" class="slider-thumb">
                                    <input id="range-max-weight" type="range" min="0" max="10000" step="1" value="10000" class="slider-thumb">
                                </div>
                            </div>
                        </div>
                        
                        <!-- LENGTH -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="length-filter-toggle" type="button"
                                        aria-controls="length-filter-section-length"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Length (cm)</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="length-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="length-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <div id="length-filter-section-length" class="pt-6 space-y-4">

                                <!-- Min / Max input alanları -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col">
                                        <input id="min-length" name="minLength" value="@Model?.Filter?.MinLength" type="number" value="" min="0" max="10000" placeholder="0 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                    <span class="text-gray-500">–</span>
                                    <div class="flex flex-col">
                                        <input id="max-length" name="maxLength" value="@Model?.Filter?.MaxLength" type="number" value="" min="0" max="10000" placeholder="10000 cm"
                                               class="w-24 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                    </div>
                                </div>

                                <!-- Tek bar, iki handle -->
                                <div class="relative h-8 flex items-center">
                                    <!-- arka bar -->
                                    <div class="absolute h-1 w-full bg-gray-200 rounded"></div>
                                    <!-- seçili aralık -->
                                    <div id="range-track-length" class="absolute h-1 rounded" style="background-color: #dc3545;"></div>

                                    <!-- Min handle -->
                                    <input id="range-min-length" type="range" min="0" max="10000" step="1" value="0" class="slider-thumb">
                                    <input id="range-max-length" type="range" min="0" max="10000" step="1" value="10000" class="slider-thumb">
                                </div>
                            </div>
                        </div>

                        <!-- COLOR -->
                        <div class="border-b border-gray-200 py-6">
                            <h3 class="-my-3 flow-root">
                                <!-- Expand/collapse section button -->
                                <button id="color-filter-toggle" type="button"
                                        aria-controls="color-filter-section-color"
                                        aria-expanded="true"
                                        class="flex w-full items-center justify-between bg-white py-3 text-sm text-gray-400 hover:text-gray-500">
                                    <span class="font-medium text-gray-900">Color</span>
                                    <span class="ml-6 flex items-center">
                                        <!-- Expand icon (+) başta gizli -->
                                        <svg id="color-icon-expand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 hidden">
                                            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                                        </svg>
                                        <!-- Collapse icon (−) başta görünüyor -->
                                        <svg id="color-icon-collapse" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                            <path d="M4 10a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H4.75A.75.75 0 0 1 4 10Z" clip-rule="evenodd" fill-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                            </h3>

                            <!-- Filter section, show/hide based on section state. -->
                            <div id="color-filter-section-color" class="pt-6">
                                <div class="space-y-6">
                                    <div class="flex gap-3">
                                        <div class="flex h-5 shrink-0 items-center">
                                            <div class="group grid size-4 grid-cols-1">
                                                <input id="filter-color-white" type="checkbox" name="SelectedColors" value="White" class="col-start-1 row-start-1"
                                                    @(Model?.Filter?.SelectedColors != null && Model.Filter.SelectedColors.Contains("White") ? "checked" : "") />
                                                <svg viewBox="0 0 14 14" fill="none" class="pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled:stroke-gray-950/25">
                                                    <path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-checked:opacity-100" />
                                                    <path d="M3 7H11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-indeterminate:opacity-100" />
                                                </svg>
                                            </div>
                                        </div>
                                        <label for="filter-mobile-color-white" class="min-w-0 flex-1 text-gray-500">White</label>
                                    </div>

                                    <div class="flex gap-3">
                                        <div class="flex h-5 shrink-0 items-center">
                                            <div class="group grid size-4 grid-cols-1">
                                                <input id="filter-color-red" type="checkbox" name="SelectedColors" value="Red" class="col-start-1 row-start-1"
                                                @(Model?.Filter?.SelectedColors != null && Model.Filter.SelectedColors.Contains("Red") ? "checked" : "") />
                                                <svg viewBox="0 0 14 14" fill="none" class="pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled:stroke-gray-950/25">
                                                    <path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-checked:opacity-100" />
                                                    <path d="M3 7H11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-indeterminate:opacity-100" />
                                                </svg>
                                            </div>
                                        </div>
                                        <label for="filter-mobile-color-red" class="min-w-0 flex-1 text-gray-500">Red</label>
                                    </div>
                                    <div class="flex gap-3">
