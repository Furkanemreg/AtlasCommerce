<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".btnAddToCart").forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();

                var productId = this.getAttribute("data-product-id");

                fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'productId=' + encodeURIComponent(productId) + '&quantity=1'
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success("Product added to cart.");
                            if (data.cartCount !== undefined) {
                                document.getElementById("cartItemCount").textContent = data.cartCount;
                            }
                        } else {
                            toastr.error("An error occurred while adding the product to the cart.");
                        }
                    })
                    .catch(() => toastr.error("Server error occurred."););
            });
        });
    });
</script>
