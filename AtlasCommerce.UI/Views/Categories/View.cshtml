<script>
    function changePageSize(select) {
        const pageSize = select.value;
        const url = new URL(window.location.href);
        url.searchParams.set('pageNumber', '1');
        url.searchParams.set('pageSize', pageSize);
        window.location.href = url.toString();
    }
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () 
    {
        //////////////////
        // SLIDER HAREKETİ (PRICE)
        const rangeMin = document.getElementById('range-min');
        const rangeMax = document.getElementById('range-max');
        const minInput = document.getElementById('min-price');
        const maxInput = document.getElementById('max-price');
        const track = document.getElementById('range-track');

        const maxValue = 999999;

        function updateTrack() {
            const minVal = parseInt(rangeMin.value);
            const maxVal = parseInt(rangeMax.value);

            const left = (minVal / maxValue) * 100;
            const right = 100 - (maxVal / maxValue) * 100;

            track.style.left = left + '%';
            track.style.right = right + '%';
        }

        rangeMin.addEventListener('input', () => {
            if (parseInt(rangeMin.value) > parseInt(rangeMax.value)) {
                rangeMin.value = rangeMax.value;
            }
            minInput.value = rangeMin.value;
            updateTrack();
        });

        rangeMax.addEventListener('input', () => {
            if (parseInt(rangeMax.value) < parseInt(rangeMin.value)) {
                rangeMax.value = rangeMin.value;
            }
            maxInput.value = rangeMax.value;
            updateTrack();
        });

        // input değişimi
        minInput.addEventListener('change', () => {
            if (parseInt(minInput.value) < 0) minInput.value = 0;
            if (parseInt(minInput.value) > parseInt(rangeMax.value)) {
                minInput.value = rangeMax.value;
            }
            rangeMin.value = minInput.value;
            updateTrack();
        });

        maxInput.addEventListener('change', () => {
            if (parseInt(maxInput.value) > maxValue) maxInput.value = maxValue;
