<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

@using AtlasCommerce.Application.ViewModels
@model CategoryListVM
@{
    ViewData["Title"] = "All Categories";
}

<style>
    :root {
        --ink: #0e0e11;
        --surface: #f5f4f0;
        --card: #ffffff;
        --accent: #337ab7;
        --accent-dark: #1d4466;
        --accent-light: rgba(51, 122, 183, 0.08);
        --muted: #9a9a9a;
        --border: #e8e7e3;
        --radius: 20px;
        --radius-sm: 14px;
    }

    .cat-shell {
        min-height: 100vh;
        background: var(--surface);
        font-family: 'DM Sans', sans-serif;
        padding: 64px 16px 80px;
    }

    .cat-container {
        max-width: 1120px;
        margin: 0 auto;
    }

    /* ── Hero ── */
    .cat-hero {
        text-align: center;
        margin-bottom: 48px;
        animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }

    .cat-eyebrow {
        font-family: 'Syne', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 10px;
    }

    .cat-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(30px, 5vw, 46px);
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.035em;
        line-height: 1.1;
    }

    /* ── Grid ── */
    .cat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    /* ── Card ── */
    .cat-card {
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        animation: fadeUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }

    .cat-card:nth-child(1) { animation-delay: 0.04s; }
    .cat-card:nth-child(2) { animation-delay: 0.08s; }
    .cat-card:nth-child(3) { animation-delay: 0.12s; }
    .cat-card:nth-child(4) { animation-delay: 0.16s; }
    .cat-card:nth-child(5) { animation-delay: 0.20s; }
    .cat-card:nth-child(6) { animation-delay: 0.24s; }

    .cat-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 48px rgba(0,0,0,0.12);
    }

    /* Image */
    .cat-img-wrap {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: var(--surface);
    }

    .cat-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }

    .cat-card:hover .cat-img-wrap img { transform: scale(1.06); }

    .cat-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(14,14,17,0.45) 0%, transparent 55%);
        pointer-events: none;
    }

    /* Top accent bar */
    .cat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--ink), var(--accent));
        z-index: 2;
        border-radius: var(--radius) var(--radius) 0 0;
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .cat-card { position: relative; }
    .cat-card:hover::before { opacity: 1; }

    /* Body */
    .cat-body {
        padding: 24px 26px 26px;
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 8px;
    }

    .cat-name {
        font-family: 'Syne', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.3;
    }

    .cat-desc {
        font-size: 13.5px;
        color: var(--muted);
        line-height: 1.65;
        flex: 1;
    }

    .cat-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        align-self: flex-start;
        background: rgba(51, 122, 183, 0.08);
        color: var(--accent);
        border: 1px solid rgba(51, 122, 183, 0.25);
        text-decoration: none;
        font-family: 'Syne', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 9px 18px;
        border-radius: 9px;
        transition: all 0.2s ease;
    }

    .cat-btn i {
        font-size: 15px;
        transition: transform 0.2s ease;
    }

    .cat-btn:hover {
        background: rgba(51, 122, 183, 0.15);
        border-color: rgba(51, 122, 183, 0.4);
        transform: translateY(-1px);
    }

    .cat-btn:hover i {
        transform: translateX(2px);
    }

    /* Empty state */
    .cat-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 80px 20px;
        color: var(--muted);
    }

    .cat-empty i {
        font-size: 48px;
        color: var(--border);
        display: block;
        margin-bottom: 16px;
    }

    .cat-empty p {
        font-size: 15px;
    }

    @@media (max-width: 640px) {
        .cat-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="cat-shell">
    <div class="cat-container">

        <!-- Hero -->
        <div class="cat-hero">
            <p class="cat-eyebrow">Browse</p>
            <h1 class="cat-title">All Categories</h1>
        </div>

        <!-- Grid -->
        <div class="cat-grid">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories)
                {
                    <div class="cat-card">
                        <div class="cat-img-wrap">
                            @if (!string.IsNullOrEmpty(category.ImageDataUri))
                            {
                                <img src="@Url.Content(category.ImageDataUri)" alt="@category.Name" />
                            }
                            else
                            {
                                <img src="~/img/placeholder.jpg" alt="@category.Name" />
                            }
                            <div class="cat-img-overlay"></div>
                        </div>
                        <div class="cat-body">
                            <div class="cat-name">@category.Name</div>
                            <div class="cat-desc">@category.Description</div>
                            <a asp-controller="Categories"
                               asp-action="View"
                               asp-route-id="@category.Id"
                               class="cat-btn">
                                View
                                <i class='bx bx-right-arrow-alt'></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="cat-empty">
                    <i class='bx bx-category'></i>
                    <p>No categories found.</p>
                </div>
            }
        </div>

    </div>
</div>