@using AtlasCommerce.Application.ViewModels

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

    var themeCookie = Context.Request.Cookies["admin-theme"] ?? "light";
    var sidebarCookie = Context.Request.Cookies["admin-sidebar"] ?? "open";

    bool isDark = themeCookie == "dark";
    bool sidebarHide = sidebarCookie == "closed";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <link rel="icon" type="image/x-icon" href="@Model?.Settings?.LogoPath" />

	<link rel="stylesheet" href="~/css/admin.css" />

    <link rel="stylesheet" href="~/css/customtable.css" />

    <title>@ViewData["Title"]</title>
</head>
<body class="isDark">
    @Html.AntiForgeryToken()

    <!-- SIDEBAR -->
    <section id="sidebar" class="@(sidebarHide ? "hide" : "")">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand mt-3">
            <img src="@Model?.Settings?.LogoPath" class="bx" />
        </a>
        <ul class="side-menu top">
            <li class="@(currentController == "Dashboard" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class='bx bxs-dashboard'></i>
                    <span class="text">Ana Sayfa</span>
                </a>
            </li>
            <li class="@(currentController == "Category" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                    <i class='bx  bx-barcode'></i>
                    <span class="text">Kategoriler</span>
                </a>
            </li>
            <li class="@(currentController == "Product" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                    <i class='bx  bx-basket'></i>
                    <span class="text">Ürünler</span>
                </a>
            </li>
            <li class="@(currentController == "Message" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Message" asp-action="Index">
                    <i class='bx bxs-message-dots'></i>
                    <span class="text">Mesajlar</span>
                </a>
            </li>
            <li class="@(currentController == "Order" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                    <i class='bx  bx-package'></i>
                    <span class="text">Siparişler</span>
                </a>
            </li>
            <li class="@(currentController == "Payment" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Payment" asp-action="Index">
                    <i class='bx  bx-wallet'></i>
                    <span class="text">Ödemeler</span>
                </a>
            </li>

            <li class="@(currentController == "Users" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class='bx bxs-group'></i>
                    <span class="text">Kullanıcılar</span>
                </a>
            </li>

            <li class="@(currentController == "Account" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Account" asp-action="Index">
                    <i class='bx bxs-group'></i>
                    <span class="text">Sistem Kullanıcıları</span>
                </a>
            </li>
        </ul>
        <ul class="side-menu">
            <li class="@(currentController == "Setting" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Setting" asp-action="Index">
                    <i class='bx bxs-cog'></i>
                    <span class="text">Ayarlar</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="/" class="logout">
                    <i class='bx bxs-log-out-circle'></i>
                    <span class="text">Çıkış Yap</span>
                </a>
            </li>
        </ul>
    </section>
    <!-- SIDEBAR -->
    <!-- CONTENT -->
    <section id="content">
        <!-- NAVBAR -->
        <nav>
            <i class='bx bx-menu'></i>
            @* <a href="#" class="nav-link">Categories</a> *@
            <form action="#">
                @* <div class="form-input">
                    <input type="search" placeholder="Arama Yap">
                    <button type="submit" class="search-btn"><i class='bx bx-search'></i></button>
                </div> *@
            </form>
            <input type="checkbox" id="switch-mode" hidden>
            <label for="switch-mode" class="switch-mode">
                <span class="sun">☀️</span>
                <span class="moon">🌙</span>
            </label>

@*             <a href="#" class="notification">
                <i class='bx bxs-bell'></i>
                <span class="num">8</span>
            </a> *@
            <a href="#" class="profile">
                <img src="@Model?.Settings?.LogoPath">
            </a>
        </nav>
        <!-- NAVBAR -->

        <!-- Generic Confirmation Modal -->
        <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalLabel">Onay</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body" id="confirmModalBody">
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="confirmModalYesBtn" class="modal-btn">Evet</button>
                        <button type="button" class="modal-btn modal-dismis-btn" data-bs-dismiss="modal">Hayır</button>
                    </div>
                </div>
            </div>
        </div>

        @RenderBody()
    </section>

    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script src="~/js/admin.js" defer asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
